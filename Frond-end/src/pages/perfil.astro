---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mi Perfil">
    <div x-data="perfilData" x-cloak class="max-w-4xl mx-auto">
        <!-- Encabezado -->
        <div class="flex items-center gap-6 mb-8">
            <div class="w-24 h-24 bg-institucional rounded-full flex items-center justify-center shadow-lg">
                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </div>
            <div>
                <h1 class="text-4xl font-bold text-institucional mb-2" x-text="userName || 'Cargando...'"></h1>
                <p class="text-gray-600 text-lg" x-text="userRole || 'Usuario'"></p>
                <p class="text-gray-500 text-sm mt-1" x-text="'Correo: ' + (userEmail || 'No disponible')"></p>
            </div>
        </div>

        <!-- Tarjeta de Información -->
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="bg-institucional text-white p-6 flex items-center gap-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h2 class="text-2xl font-bold">Información de Perfil</h2>
            </div>
            
            <div class="p-8">
                <div class="grid md:grid-cols-2 gap-8">
                    <!-- Información Personal -->
                    <div>
                        <h3 class="text-xl font-bold text-institucional mb-6">Datos Personales</h3>
                        
                        <div class="space-y-4">
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Nombre Completo</label>
                                <p class="text-lg mt-1" x-text="userName || 'No disponible'"></p>
                            </div>
                            
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Correo Electrónico</label>
                                <p class="text-lg mt-1" x-text="userEmail || 'No disponible'"></p>
                            </div>
                            
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">ID de Usuario</label>
                                <p class="text-lg mt-1 font-mono text-gray-600" x-text="userId || 'No disponible'"></p>
                            </div>
                        </div>
                    </div>

                    <!-- Información de Acceso -->
                    <div>
                        <h3 class="text-xl font-bold text-institucional mb-6">Información de Acceso</h3>
                        
                        <div class="space-y-4">
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Rol Actual</label>
                                <div class="mt-1 flex items-center gap-2">
                                    <span class="px-3 py-1 bg-institucional text-white rounded-full text-sm font-weighted" x-text="userRole || 'No disponible'"></span>
                                </div>
                            </div>
                            
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Roles Asignados</label>
                                <div class="mt-2 flex flex-wrap gap-2">
                                    <template x-for="role in userRoles" :key="role">
                                        <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm" x-text="role"></span>
                                    </template>
                                </div>
                            </div>
                            
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Último Acceso</label>
                                <p class="text-lg mt-1" x-text="lastLogin || 'Primera sesión'"></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sección de Permisos -->
        <div class="bg-white rounded-xl shadow-lg overflow-hidden mt-8">
            <div class="bg-institucional text-white p-6 flex items-center gap-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <h2 class="text-2xl font-bold">Permisos</h2>
            </div>
            
            <div class="p-8">
                <div x-show="userPermissions.length > 0" class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <template x-for="permission in userPermissions" :key="permission">
                        <div class="flex items-center gap-3 p-4 border rounded-lg border-green-200 bg-green-50">
                            <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                            </svg>
                            <span class="font-medium text-gray-800" x-text="permission"></span>
                        </div>
                    </template>
                </div>
                <div x-show="userPermissions.length === 0" class="text-center py-8 text-gray-500">
                    <p>No hay permisos asignados</p>
                </div>
            </div>
        </div>

        <!-- Botone de Acción -->
        <div class="flex gap-4 mt-8">
            <button @click="editProfile()" class="px-6 py-3 bg-institucional text-white font-semibold rounded-lg hover:opacity-90 transition-all flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                Editar Perfil
            </button>
            <button @click="changePassword()" class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:opacity-90 transition-all flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.97 5.95m-2.02-2.02a7 7 0 10-9.95 9.95" />
                </svg>
                Cambiar Contraseña
            </button>
        </div>
    </div>

    <!-- Modal de Edición -->
    <div x-show="showEditModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-xl max-w-2xl w-full p-8 my-8">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold text-institucional">Editar Perfil</h3>
                <button @click="showEditModal = false" class="text-gray-500 hover:text-gray-700">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form @submit.prevent="updateProfile()" class="space-y-6">
                <!-- Nombre y Apellido -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Nombre</label>
                        <input 
                            type="text" 
                            x-model="formData.name" 
                            placeholder="Tu nombre"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                        >
                        <template x-if="errors.name">
                            <p class="text-red-500 text-sm mt-1" x-text="errors.name[0]"></p>
                        </template>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Apellido</label>
                        <input 
                            type="text" 
                            x-model="formData.last_name" 
                            placeholder="Tu apellido"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                        >
                        <template x-if="errors.last_name">
                            <p class="text-red-500 text-sm mt-1" x-text="errors.last_name[0]"></p>
                        </template>
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Correo Electrónico</label>
                    <input 
                        type="email" 
                        x-model="formData.email" 
                        placeholder="tu@email.com"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                    >
                    <template x-if="errors.email">
                        <p class="text-red-500 text-sm mt-1" x-text="errors.email[0]"></p>
                    </template>
                </div>

                <!-- Teléfono -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Teléfono</label>
                    <input 
                        type="tel" 
                        x-model="formData.phone_number" 
                        placeholder="+5215512345678"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                    >
                    <template x-if="errors.phone_number">
                        <p class="text-red-500 text-sm mt-1" x-text="errors.phone_number[0]"></p>
                    </template>
                </div>

                <!-- Fecha de Nacimiento y Género -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Fecha de Nacimiento</label>
                        <input 
                            type="date" 
                            x-model="formData.birthdate"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                        >
                        <template x-if="errors.birthdate">
                            <p class="text-red-500 text-sm mt-1" x-text="errors.birthdate[0]"></p>
                        </template>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Género</label>
                        <select x-model="formData.gender" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none">
                            <option value="">Selecciona...</option>
                            <option value="male">Masculino</option>
                            <option value="female">Femenino</option>
                            <option value="other">Otro</option>
                        </select>
                        <template x-if="errors.gender">
                            <p class="text-red-500 text-sm mt-1" x-text="errors.gender[0]"></p>
                        </template>
                    </div>
                </div>

                <!-- Tipo de Sangre -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Tipo de Sangre</label>
                    <select x-model="formData.blood_type" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none">
                        <option value="">Selecciona...</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                    </select>
                    <template x-if="errors.blood_type">
                        <p class="text-red-500 text-sm mt-1" x-text="errors.blood_type[0]"></p>
                    </template>
                </div>

                <!-- Dirección -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Dirección</label>
                    <input 
                        type="text" 
                        x-model="formData.address" 
                        placeholder="Tu dirección"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                    >
                    <template x-if="errors.address">
                        <p class="text-red-500 text-sm mt-1" x-text="errors.address[0]"></p>
                    </template>
                </div>

                <!-- Mensajes de Estado -->
                <template x-if="successMessage">
                    <div class="p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
                        <p x-text="successMessage"></p>
                    </div>
                </template>

                <template x-if="errorMessage">
                    <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
                        <p x-text="errorMessage"></p>
                    </div>
                </template>

                <!-- Botones de Acción -->
                <div class="flex gap-4 justify-end pt-6 border-t">
                    <button 
                        type="button"
                        @click="showEditModal = false" 
                        class="px-6 py-2 bg-gray-300 text-gray-800 font-semibold rounded-lg hover:bg-gray-400 transition-all"
                    >
                        Cancelar
                    </button>
                    <button 
                        type="submit"
                        :disabled="isUpdating"
                        class="px-6 py-2 bg-institucional text-white font-semibold rounded-lg hover:opacity-90 transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"
                    >
                        <span x-show="!isUpdating">Guardar Cambios</span>
                        <span x-show="isUpdating">Guardando...</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal de Cambiar Contraseña -->
    <div x-show="showPasswordModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-xl max-w-md w-full p-8 my-8">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold text-institucional">Cambiar Contraseña</h3>
                <button @click="showPasswordModal = false" class="text-gray-500 hover:text-gray-700">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form @submit.prevent="submitChangePassword()" class="space-y-6">
                <!-- Contraseña Actual -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Contraseña Actual</label>
                    <input 
                        type="password" 
                        x-model="passwordData.currentPassword" 
                        placeholder="Tu contraseña actual"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                    >
                    <template x-if="passwordErrors.currentPassword">
                        <p class="text-red-500 text-sm mt-1" x-text="passwordErrors.currentPassword[0]"></p>
                    </template>
                </div>

                <!-- Nueva Contraseña -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Nueva Contraseña</label>
                    <input 
                        type="password" 
                        x-model="passwordData.newPassword" 
                        placeholder="Mínimo 8 caracteres"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                    >
                    <template x-if="passwordErrors.newPassword">
                        <p class="text-red-500 text-sm mt-1" x-text="passwordErrors.newPassword[0]"></p>
                    </template>
                </div>

                <!-- Confirmar Contraseña -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Confirmar Contraseña</label>
                    <input 
                        type="password" 
                        x-model="passwordData.confirmPassword" 
                        placeholder="Confirma tu nueva contraseña"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                    >
                </div>

                <!-- Mensajes de Estado -->
                <template x-if="passwordSuccessMessage">
                    <div class="p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
                        <p x-text="passwordSuccessMessage"></p>
                    </div>
                </template>

                <template x-if="passwordErrorMessage">
                    <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
                        <p x-text="passwordErrorMessage"></p>
                    </div>
                </template>

                <!-- Botones de Acción -->
                <div class="flex gap-4 justify-end pt-6 border-t">
                    <button 
                        type="button"
                        @click="showPasswordModal = false" 
                        class="px-6 py-2 bg-gray-300 text-gray-800 font-semibold rounded-lg hover:bg-gray-400 transition-all"
                    >
                        Cancelar
                    </button>
                    <button 
                        type="submit"
                        :disabled="isChangingPassword"
                        class="px-6 py-2 bg-institucional text-white font-semibold rounded-lg hover:opacity-90 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        <span x-show="!isChangingPassword">Cambiar Contraseña</span>
                        <span x-show="isChangingPassword">Procesando...</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script is:inline define:vars={{ API_BASE_URL: 'https://nginx-production-728f.up.railway.app/api' }}>
        document.addEventListener('alpine:init', () => {
            Alpine.data('perfilData', () => ({
                userName: '',
                userEmail: '',
                userRole: '',
                userId: '',
                userRoles: [],
                userPermissions: [],
                lastLogin: '',
                showEditModal: false,
                showPasswordModal: false,
                isUpdating: false,
                successMessage: '',
                errorMessage: '',
                errors: {},

                formData: {
                    name: '',
                    last_name: '',
                    email: '',
                    phone_number: '',
                    birthdate: '',
                    gender: '',
                    blood_type: '',
                    address: ''
                },

                passwordData: {
                    currentPassword: '',
                    newPassword: '',
                    confirmPassword: ''
                },
                passwordErrors: {},
                isChangingPassword: false,
                passwordSuccessMessage: '',
                passwordErrorMessage: '',

                init() {
                    this.loadUserData();
                },

                async loadUserData() {
                    const token = localStorage.getItem('token');
                    if (!token) {
                        console.log('No token found, using localStorage fallback');
                        this.loadUserDataFromStorage();
                        return;
                    }

                    try {
                        const response = await fetch(API_BASE_URL + '/v1/users/user', {
                            method: 'GET',
                            headers: {
                                'Authorization': 'Bearer ' + token,
                                'Accept': 'application/json'
                            }
                        });

                        if (response.ok) {
                            const data = await response.json();
                            if (data.success && data.data?.user) {
                                const user = data.data.user;
                                localStorage.setItem('user_data', JSON.stringify(user));
                                this.populateUserData(user);
                                console.log('User data loaded from API');
                            } else {
                                console.log('Invalid API response, using localStorage fallback');
                                this.loadUserDataFromStorage();
                            }
                        } else if (response.status === 401 || response.status === 403) {
                            console.log('Unauthorized, using localStorage fallback');
                            this.loadUserDataFromStorage();
                        } else {
                            console.log('API error, using localStorage fallback');
                            this.loadUserDataFromStorage();
                        }
                    } catch (err) {
                        console.error('Error fetching user data from API:', err);
                        console.log('Using localStorage fallback');
                        this.loadUserDataFromStorage();
                    }
                },

                loadUserDataFromStorage() {
                    const userData = localStorage.getItem('user_data');
                    if (!userData) {
                        console.log('No user data found');
                        return;
                    }

                    try {
                        const user = JSON.parse(userData);
                        this.populateUserData(user);
                    } catch (e) {
                        console.error('Error parsing user data:', e);
                    }
                },

                populateUserData(user) {
                    this.userName = user.name || user.username || 'Sin nombre';
                    this.userEmail = user.email || 'No disponible';
                    this.userId = user.id || 'No disponible';
                    this.userRole = user.roles?.length > 0 ? user.roles[0] : 'Usuario';
                    this.userRoles = user.roles || [];
                    this.userPermissions = user.permissions || [];
                    this.lastLogin = new Date().toLocaleDateString('es-ES', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });

                    // Populate form data
                    this.formData.name = user.name || '';
                    this.formData.last_name = user.last_name || '';
                    this.formData.email = user.email || '';
                    this.formData.phone_number = user.phone_number || '';
                    this.formData.birthdate = user.birthdate || '';
                    this.formData.gender = user.gender || '';
                    this.formData.blood_type = user.blood_type || '';
                    this.formData.address = Array.isArray(user.address) && user.address[0] ? user.address[0] : '';

                    console.log('User data populated:', {
                        name: this.userName,
                        email: this.userEmail,
                        id: this.userId
                    });
                },

                editProfile() {
                    // Cargar datos actuales en el formulario
                    const userData = localStorage.getItem('user_data');
                    if (userData) {
                        try {
                            const user = JSON.parse(userData);
                            this.formData = {
                                name: user.name || '',
                                last_name: user.last_name || '',
                                email: user.email || '',
                                phone_number: user.phone_number || '',
                                birthdate: user.birthdate ? user.birthdate.split('T')[0] : '',
                                gender: user.gender || '',
                                blood_type: user.blood_type || '',
                                address: Array.isArray(user.address) ? user.address.join(', ') : (user.address || '')
                            };
                            console.log('Form data loaded:', this.formData);
                        } catch (e) {
                            console.error('Error loading form data:', e);
                        }
                    }
                    this.showEditModal = true;
                },

                async updateProfile() {
                    this.isUpdating = true;
                    this.successMessage = '';
                    this.errorMessage = '';
                    this.errors = {};

                    const token = localStorage.getItem('token');
                    if (!token) {
                        this.errorMessage = 'No estás autenticado. Por favor inicia sesión.';
                        this.isUpdating = false;
                        return;
                    }

                    // Preparar los datos para enviar
                    const requestData = {
                        name: this.formData.name,
                        last_name: this.formData.last_name,
                        email: this.formData.email,
                        phone_number: this.formData.phone_number,
                        birthdate: this.formData.birthdate,
                        gender: this.formData.gender,
                        blood_type: this.formData.blood_type
                    };

                    // Convertir dirección a array si es necesario
                    if (this.formData.address) {
                        requestData.address = [this.formData.address];
                    }

                    console.log('Sending update request:', requestData);

                    try {
                        const response = await fetch(API_BASE_URL + '/v1/users/update', {
                            method: 'PATCH',
                            headers: {
                                'Authorization': 'Bearer ' + token,
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify(requestData)
                        });

                        const data = await response.json();
                        console.log('Response status:', response.status);
                        console.log('Response data:', data);

                        if (response.ok && data.success) {
                            this.successMessage = data.message || 'Perfil actualizado correctamente';
                            
                            // Actualizar datos en localStorage
                            const updatedUser = data.data.user;
                            localStorage.setItem('user_data', JSON.stringify(updatedUser));
                            
                            // Actualizar la visualización
                            this.userName = updatedUser.name || updatedUser.username || 'Sin nombre';
                            this.userEmail = updatedUser.email || 'No disponible';
                            
                            console.log('✅ Perfil actualizado exitosamente');
                            
                            // Cerrar modal después de 2 segundos
                            setTimeout(() => {
                                this.showEditModal = false;
                                this.successMessage = '';
                            }, 2000);
                        } else {
                            // Manejar errores de validación
                            if (data.errors) {
                                this.errors = data.errors;
                                const firstErrorKey = Object.keys(data.errors)[0];
                                const firstError = data.errors[firstErrorKey];
                                this.errorMessage = Array.isArray(firstError) ? firstError[0] : firstError;
                            } else {
                                this.errorMessage = data.message || 'Error al actualizar el perfil';
                            }
                            console.error('❌ Error en la actualización:', data);
                        }
                    } catch (err) {
                        console.error('Error updating profile:', err);
                        this.errorMessage = 'Error de conexión con el servidor';
                    } finally {
                        this.isUpdating = false;
                    }
                },

                changePassword() {
                    this.showPasswordModal = true;
                    this.passwordData = { currentPassword: '', newPassword: '', confirmPassword: '' };
                    this.passwordErrors = {};
                    this.passwordSuccessMessage = '';
                    this.passwordErrorMessage = '';
                },

                async submitChangePassword() {
                    this.isChangingPassword = true;
                    this.passwordSuccessMessage = '';
                    this.passwordErrorMessage = '';
                    this.passwordErrors = {};

                    // Validación del lado del cliente
                    if (!this.passwordData.currentPassword) {
                        this.passwordErrorMessage = 'La contraseña actual es requerida';
                        this.isChangingPassword = false;
                        return;
                    }

                    if (!this.passwordData.newPassword) {
                        this.passwordErrorMessage = 'La nueva contraseña es requerida';
                        this.isChangingPassword = false;
                        return;
                    }

                    if (this.passwordData.newPassword.length < 8) {
                        this.passwordErrorMessage = 'La contraseña debe tener al menos 8 caracteres';
                        this.isChangingPassword = false;
                        return;
                    }

                    if (this.passwordData.newPassword !== this.passwordData.confirmPassword) {
                        this.passwordErrorMessage = 'Las contraseñas no coinciden';
                        this.isChangingPassword = false;
                        return;
                    }

                    const token = localStorage.getItem('token');
                    if (!token) {
                        this.passwordErrorMessage = 'No estás autenticado. Por favor inicia sesión.';
                        this.isChangingPassword = false;
                        return;
                    }

                    try {
                        const response = await fetch(API_BASE_URL + '/v1/users/update/password', {
                            method: 'PATCH',
                            headers: {
                                'Authorization': 'Bearer ' + token,
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({
                                currentPassword: this.passwordData.currentPassword,
                                newPassword: this.passwordData.newPassword
                            })
                        });

                        const data = await response.json();

                        if (response.ok && data.success) {
                            this.passwordSuccessMessage = data.message || 'Contraseña actualizada correctamente';
                            
                            setTimeout(() => {
                                this.showPasswordModal = false;
                                this.passwordData = { currentPassword: '', newPassword: '', confirmPassword: '' };
                                this.passwordSuccessMessage = '';
                            }, 2000);
                        } else {
                            if (data.errors) {
                                this.passwordErrors = data.errors;
                                const firstErrorKey = Object.keys(data.errors)[0];
                                const firstError = data.errors[firstErrorKey];
                                this.passwordErrorMessage = Array.isArray(firstError) ? firstError[0] : firstError;
                            } else if (response.status === 400) {
                                this.passwordErrorMessage = 'La contraseña actual es incorrecta';
                            } else {
                                this.passwordErrorMessage = data.message || 'Error al cambiar la contraseña';
                            }
                        }
                    } catch (err) {
                        console.error('Error changing password:', err);
                        this.passwordErrorMessage = 'Error de conexión con el servidor';
                    } finally {
                        this.isChangingPassword = false;
                    }
                }
            }));
        });
    </script>

    <style is:global>
        [x-cloak] { display: none !important; }
    </style>
</Layout>
