      x-init="$nextTick(() => {
        const self = $data;
        (async () => {
          console.log('🚀 Inicializando formulario de conceptos...');
          self.apiBaseUrl = window.__API_BASE_URL__ || '';
          const token = localStorage.getItem('access_token');
          
          // Cargar careers y students primero
