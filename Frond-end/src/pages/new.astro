---
// src/pages/new.astro
import Layout from '../layouts/Layout.astro';
// Asume Tailwind configurado
const API_BASE_URL = 'https://nginx-production-728f.up.railway.app/api';
---

<Layout title="Crear Concepto - CBTA 71">
  <script is:inline define:vars={{ API_BASE_URL }}>
    window.__API_BASE_URL__ = API_BASE_URL;
    window.conceptFormData = {
      CAREERS: [
        { code: 'TAG-E', name: 'Técnico Agropecuario' },
        { code: 'TOF', name: 'Técnico en Ofimática' },
        { code: 'TEM', name: 'Técnico en Admón. de Emprendimiento' },
        { code: 'TAG-M', name: 'Técnico Agropecuario (modalidad mixta)' },
        { code: 'TRH', name: 'Técnico en Admón. de Recursos Humanos (modalidad mixta)' },
      ],
      // Inicializar con datos de fallback para asegurar que siempre haya carreras
      careers: [
        { id: 'TAG-E', name: 'Técnico Agropecuario' },
        { id: 'TOF', name: 'Técnico en Ofimática' },
        { id: 'TEM', name: 'Técnico en Admón. de Emprendimiento' },
        { id: 'TAG-M', name: 'Técnico Agropecuario (modalidad mixta)' },
        { id: 'TRH', name: 'Técnico en Admón. de Recursos Humanos (modalidad mixta)' },
      ],
      // Inicializar con semestres 1-12
      semesters: [
        { id: '1', name: '1°' }, { id: '2', name: '2°' }, { id: '3', name: '3°' },
        { id: '4', name: '4°' }, { id: '5', name: '5°' }, { id: '6', name: '6°' },
        { id: '7', name: '7°' }, { id: '8', name: '8°' }, { id: '9', name: '9°' },
        { id: '10', name: '10°' }, { id: '11', name: '11°' }, { id: '12', name: '12°' }
      ],
      allStudents: [],
      isSaving: false,
      formData: {
        id: null,
        title: '',
        amount: 0,
        description: '',
        status: 'active',
        startDate: '',
        endDate: '',
        allStudents: true,
        selectedCareers: [],
        selectedSemesters: [],
        selectedSpecificStudents: []
      },
      searchTerm: '',
      errorMessage: '',
      
      apiBaseUrl: window.__API_BASE_URL__ || '',
      
      loadCareers() {
        console.log('🔄 Cargando carreras...');
        const token = localStorage.getItem('access_token');
        if (!token) {
          console.log('⚠️ No hay token, usando datos por defecto');
          this.careers = this.CAREERS.map(c => ({ id: c.code, name: c.name }));
          console.log('✅ Carreras cargadas (fallback):', this.careers.length);
          return;
        }
        const url = new URL(this.apiBaseUrl + '/v1/careers');
        url.searchParams.set('forceRefresh', 'false');
        fetch(url.toString(), {
          method: 'GET',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          }
        })
        .then(res => {
          if (!res.ok) {
            console.warn(`⚠️ Careers API returned ${res.status}, using fallback`);
            throw new Error(`HTTP ${res.status}`);
          }
          return res.json();
        })
        .then(json => {
          console.log('📦 Respuesta API carreras:', json);
          if (json.success && json.data?.careers) {
            this.careers = json.data.careers.map(c => ({ id: c.id, name: c.career_name }));
            console.log('✅ Carreras cargadas desde API:', this.careers.length);
          } else {
            console.log('⚠️ Respuesta API sin estructura esperada, usando fallback');
            this.careers = this.CAREERS.map(c => ({ id: c.code, name: c.name }));
            console.log('✅ Carreras cargadas (fallback):', this.careers.length);
          }
        })
        .catch(err => {
          console.warn('❌ Error al cargar carreras desde API:', err.message);
          this.careers = this.CAREERS.map(c => ({ id: c.code, name: c.name }));
          console.log('✅ Carreras cargadas (fallback):', this.careers.length);
        });
      },

      loadStudents() {
        const token = localStorage.getItem('access_token');
        const mapStudents = (items = []) => {
          this.allStudents = items.map(item => {
            const fullName = (
              item.fullName || item.nombre || [
                String(item.nombre ?? '').trim(),
                String(item.apellidoP ?? item.apellidoPaterno ?? '').trim(),
                String(item.apellidoM ?? item.apellidoMaterno ?? '').trim()
              ].filter(n => n).join(' ')
            ).trim();
            const userId = item.userId ?? item.id ?? item.user_id ?? null;
            const control = item.numControl ?? item.num_control ?? item.n_control ?? '';
            const careerId = item.career_id ?? item.careerId ?? null;
            const careerName = item.career_name ?? item.carrera ?? item.career ?? '';
            const normalizedCareerId = careerId !== null && careerId !== undefined ? String(careerId) : (careerName ? String(careerName) : '');
            const semester = item.semestre ?? item.semester ?? '';
            return {
              id: userId ? String(userId) : '',
              control: String(control || ''),
              name: fullName || 'Sin nombre',
              careerId: normalizedCareerId,
              careerName: String(careerName || ''),
              semester: String(semester || '')
            };
          }).filter(s => s.id);
          const semesterSet = new Set();
          this.allStudents.forEach(s => {
            if (s.semester) semesterSet.add(String(s.semester));
          });
          // Si no hay semestres en los estudiantes, usar 1-12 como respaldo
          if (semesterSet.size === 0) {
            for (let i = 1; i <= 12; i++) {
              semesterSet.add(String(i));
            }
          }
          this.semesters = Array.from(semesterSet)
            .sort((a, b) => Number(a) - Number(b))
            .map(id => ({ id, name: id + '°' }));
        };
        // Intentar cargar desde localStorage primero (más rápido)
        const loadFromLocalStorage = () => {
          const raw = localStorage.getItem('studentsList');
          if (raw) {
            try {
              const parsed = JSON.parse(raw);
              if (Array.isArray(parsed) && parsed.length) {
                console.log(`✅ Usuarios cargados desde localStorage: ${parsed.length}`);
                mapStudents(parsed);
                return true;
              }
            } catch (e) {
              console.error('Error parsing localStorage:', e);
            }
          }
          return false;
        };

        // Si hay datos en localStorage, usarlos y NO hacer petición API
        if (loadFromLocalStorage()) {
          return;
        }

        // Si no hay localStorage NI token, mostrar lista vacía
        if (!token) {
          console.info('💡 Tip: Inicia sesión y visita /roles para cargar la lista de usuarios');
          mapStudents([]);
          return;
        }

        // Solo si NO hay localStorage, intentar cargar desde API
        const url = new URL(this.apiBaseUrl + '/v1/admin-actions/show-users');
        url.searchParams.append('page', '1');
        url.searchParams.append('perPage', '1000');
        url.searchParams.append('status', 'activo');
        
        const userRole = localStorage.getItem('user_role') || 'admin';
        const userPermission = localStorage.getItem('user_permission') || 'view.users';
        
        fetch(url.toString(), {
          method: 'GET',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`,
            'X-User-Role': userRole,
            'X-User-Permission': userPermission
          }
        })
        .then(res => {
          if (!res.ok) {
            throw new Error(`HTTP ${res.status}`);
          }
          return res.json();
        })
        .then(json => {
          const items = json.data?.users?.items || json.data?.items || json.data || [];
          if (Array.isArray(items) && items.length) {
            console.log(`✅ Usuarios cargados desde API: ${items.length}`);
            mapStudents(items);
            localStorage.setItem('studentsList', JSON.stringify(items));
          } else {
            console.info('💡 Tip: Visita /roles para cargar la lista de usuarios completa');
            mapStudents([]);
          }
        })
        .catch(() => {
          console.info('💡 Tip: Visita /roles para cargar y cachear la lista de usuarios');
          mapStudents([]);
        });
      },

      populateForm(concept) {
        this.formData.id = concept.id;
        this.formData.title = concept.title;
        this.formData.amount = concept.amount;
        this.formData.description = concept.description || '';
        this.formData.status = concept.status;
        this.formData.startDate = concept.start_date || concept.startDate || '';
        this.formData.endDate = concept.end_date || concept.endDate || '';
        if (concept.scopeRules) {
          this.formData.allStudents = concept.scopeRules.allStudents;
          this.formData.selectedCareers = concept.scopeRules.careers || [];
          this.formData.selectedSemesters = concept.scopeRules.semesters || [];
          if (Array.isArray(concept.scopeRules.specificStudents)) {
            this.formData.selectedSpecificStudents = concept.scopeRules.specificStudents.map(id => {
              const student = this.allStudents.find(s => String(s.id) === String(id));
              return student ? {id: student.id, name: student.name, control: student.control} : {id: String(id), name: 'ID: ' + id, control: ''};
            });
          }
        }
      },

      toggleSpecificStudent(student) {
        const index = this.formData.selectedSpecificStudents.findIndex(s => s.id === student.id);
        if (index === -1) {
          this.formData.selectedSpecificStudents.push({
            id: student.id,
            name: student.name,
            control: student.control
          });
        } else {
          this.formData.selectedSpecificStudents.splice(index, 1);
        }
        this.searchTerm = '';
      },

      get filteredStudents() {
        if (!this.searchTerm) return [];
        const searchLower = this.searchTerm.toLowerCase();
        const careerFilter = this.formData.selectedCareers;
        const semesterFilter = this.formData.selectedSemesters;
        return this.allStudents.filter(student => {
          const matchesSearch =
            student.name.toLowerCase().includes(searchLower) ||
            String(student.control || '').includes(searchLower) ||
            String(student.id || '').includes(searchLower);
          const matchesCareer = !careerFilter.length || careerFilter.includes(student.careerId);
          const matchesSemester = !semesterFilter.length || semesterFilter.includes(student.semester);
          return matchesSearch && matchesCareer && matchesSemester;
        }).slice(0, 8);
      },

      removeSpecificStudent(studentId) {
        this.formData.selectedSpecificStudents = this.formData.selectedSpecificStudents.filter(s => s.id !== studentId);
      },

      submitForm() {
        this.errorMessage = '';
        if (this.isSaving) return;
        if (!this.formData.title || !this.formData.amount || parseFloat(this.formData.amount) <= 0) {
          this.errorMessage = '⚠️ Rellene Título y Monto (mayor a $0).';
          return;
        }
        if (!this.formData.startDate || !this.formData.endDate) {
          this.errorMessage = '⚠️ Las fechas de inicio y fin son obligatorias.';
          return;
        }
        if (!this.formData.allStudents) {
          const hasCareer = this.formData.selectedCareers.length > 0;
          const hasSemester = this.formData.selectedSemesters.length > 0;
          const hasSpecific = this.formData.selectedSpecificStudents.length > 0;
          if (!hasCareer && !hasSemester && !hasSpecific) {
            this.errorMessage = '⚠️ Seleccione al menos una Carrera, Semestre o Alumno.';
            return;
          }
        }
        const payload = {
          concept_name: this.formData.title,
          description: this.formData.description || '',
          status: this.formData.status === 'active' ? 'activo' : 'inactivo',
          amount: parseFloat(this.formData.amount),
          start_date: this.formData.startDate,
          end_date: this.formData.endDate,
          is_global: Boolean(this.formData.allStudents)
        };
        
        // Construir applies_to y campos relacionados según alcance
        if (this.formData.allStudents) {
          // Para todos - NO incluir campos de filtro
          payload.applies_to = 'todos';
          // Explícitamente NO incluir campos de filtro
          delete payload.students;
          delete payload.student;
          delete payload.semestre;
          delete payload.semestres;
          delete payload.career;
          delete payload.carrera;
          delete payload.careers;
          delete payload.carreras;
        } else {
          // Alcance restringido - incluir solo los filtros especificados
          if (this.formData.selectedSpecificStudents.length > 0) {
            payload.applies_to = 'estudiantes';
            payload.students = this.formData.selectedSpecificStudents.map(s => String(s.id));
          } else if (this.formData.selectedSemesters.length > 0 && this.formData.selectedCareers.length > 0) {
            // Ambas carreras y semestres seleccionados
            payload.applies_to = 'carrera_semestre';
            payload.careers = this.formData.selectedCareers.map(c => String(c));
            payload.semestres = this.formData.selectedSemesters.map(s => parseInt(s));
          } else if (this.formData.selectedSemesters.length > 0) {
            payload.applies_to = 'semestre';
            payload.semestres = this.formData.selectedSemesters.map(s => parseInt(s));
          } else if (this.formData.selectedCareers.length > 0) {
            payload.applies_to = 'carrera';
            payload.careers = this.formData.selectedCareers.map(c => String(c));
          } else {
            // Sin filtros seleccionados - aplicar a todos por defecto
            payload.applies_to = 'todos';
            // Explícitamente NO incluir campos de filtro
            delete payload.students;
            delete payload.student;
            delete payload.semestre;
            delete payload.semestres;
            delete payload.career;
            delete payload.carrera;
            delete payload.careers;
            delete payload.carreras;
          }
        }
        console.log('Sending payload:', payload);
        const token = localStorage.getItem('access_token');
        if (!token) {
          this.errorMessage = '❌ No hay token, inicia sesión.';
          return;
        }
        this.isSaving = true;
        const self = this;
        const executeSubmit = () => {
          if (window.AdminAPI && window.AdminAPI.createConcept) {
            if (self.formData.id) {
              return window.AdminAPI.updateConcept(self.formData.id, token, payload);
            } else {
              return window.AdminAPI.createConcept(token, payload);
            }
          } else {
            // CREAR nuevo concepto: enviar todo junto en POST
            if (!self.formData.id) {
              return fetch(`${self.apiBaseUrl}/v1/concepts`, {
                method: 'POST',
                headers: {
                  'Accept': 'application/json',
                  'Content-Type': 'application/json',
                  'Authorization': `Bearer ${token}`,
                  'X-User-Role': 'financial-staff',
                  'X-User-Permission': 'create.concepts'
                },
                body: JSON.stringify(payload)
              }).then(async res => {
                const data = await res.json().catch(() => ({}));
                if (!res.ok) {
                  let errorMsg = data.message || res.statusText || 'Error desconocido';
                  if (data.errors && typeof data.errors === 'object') {
                    const errorList = Object.entries(data.errors)
                      .map(([field, messages]) => `${field}: ${Array.isArray(messages) ? messages.join(', ') : messages}`)
                      .join(' | ');
                    errorMsg = `${errorMsg} - ${errorList}`;
                  }
                  console.error('Backend validation errors:', data.errors);
                  return Promise.reject(new Error(errorMsg));
                }
                return data;
              });
            }
            
            // ACTUALIZAR concepto existente: separar en dos peticiones
            // 1. Actualizar datos básicos con PUT
            const basicData = {
              concept_name: payload.concept_name,
              description: payload.description,
              status: payload.status,
              amount: payload.amount,
              start_date: payload.start_date,
              end_date: payload.end_date
            };
            
            console.log('📤 Actualizando datos básicos:', basicData);
            
            return fetch(`${self.apiBaseUrl}/v1/concepts/${self.formData.id}`, {
              method: 'PUT',
              headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`,
                'X-User-Role': 'financial-staff',
                'X-User-Permission': 'update.concepts'
              },
              body: JSON.stringify(basicData)
            })
            .then(async res => {
              const data = await res.json().catch(() => ({}));
              if (!res.ok) {
                let errorMsg = data.message || res.statusText || 'Error al actualizar datos básicos';
                if (data.errors && typeof data.errors === 'object') {
                  const errorList = Object.entries(data.errors)
                    .map(([field, messages]) => `${field}: ${Array.isArray(messages) ? messages.join(', ') : messages}`)
                    .join(' | ');
                  errorMsg = `${errorMsg} - ${errorList}`;
                }
                console.error('Backend validation errors:', data.errors);
                return Promise.reject(new Error(errorMsg));
              }
              console.log('✅ Datos básicos actualizados');
              return data;
            })
            .then(basicResult => {
              // 2. Actualizar relaciones con PATCH - SOLO si hay datos de relaciones cargados
              const hasRelationsData = 
                payload.applies_to && (
                  (payload.students && payload.students.length > 0) ||
                  (payload.careers && payload.careers.length > 0) ||
                  (payload.semestres && payload.semestres.length > 0) ||
                  payload.applies_to === 'todos'
                );
              
              // Si NO hay datos de relaciones cargados (formulario vacío), saltar la actualización de relaciones
              // para no borrar los datos existentes en el backend
              if (!hasRelationsData) {
                console.log('⚠️ No hay datos de relaciones para actualizar, manteniendo los existentes');
                return basicResult;
              }
              
              const relationsData = {
                applies_to: payload.applies_to
              };
              
              // Agregar campos de relaciones solo si existen
              if (payload.students) relationsData.students = payload.students;
              if (payload.careers) relationsData.careers = payload.careers;
              if (payload.semestres) relationsData.semestres = payload.semestres;
              
              console.log('📤 Actualizando relaciones:', relationsData);
              
              return fetch(`${self.apiBaseUrl}/v1/concepts/update-relations/${self.formData.id}`, {
                method: 'PATCH',
                headers: {
                  'Accept': 'application/json',
                  'Content-Type': 'application/json',
                  'Authorization': `Bearer ${token}`,
                  'X-User-Role': 'financial-staff',
                  'X-User-Permission': 'update.concepts'
                },
                body: JSON.stringify(relationsData)
              })
              .then(async res => {
                const data = await res.json().catch(() => ({}));
                if (!res.ok) {
                  let errorMsg = data.message || res.statusText || 'Error al actualizar relaciones';
                  if (data.errors && typeof data.errors === 'object') {
                    const errorList = Object.entries(data.errors)
                      .map(([field, messages]) => `${field}: ${Array.isArray(messages) ? messages.join(', ') : messages}`)
                      .join(' | ');
                    errorMsg = `${errorMsg} - ${errorList}`;
                  }
                  console.error('Backend validation errors:', data.errors);
                  return Promise.reject(new Error(errorMsg));
                }
                console.log('✅ Relaciones actualizadas');
                return data;
              });
            });
          }
        };
        executeSubmit()
          .then(result => {
            console.log('✅ Resultado:', result);
            localStorage.removeItem('editingConcept');
            self.errorMessage = '✓ Concepto guardado exitosamente. Redirigiendo...';
            setTimeout(() => { window.location.href = '/concepts'; }, 1200);
          })
          .catch(err => {
            console.error('❌ Error completo:', err);
            self.errorMessage = `❌ ${err.message || 'Error desconocido'}`;
            self.isSaving = false;
          })
          .finally(() => {
            self.isSaving = false;
          });
      },

      cancel() {
        localStorage.removeItem('editingConcept');
        window.location.href = '/concepts';
      }
    };
  </script>
  <style>
    /* Estilos de Alpine.js: MANTENER */
    [x-cloak] { display: none !important; }
    
    /* Variables y estilos personalizados: COLOR FINAL #2E594D */
    :root {
      --primary-solid: #2E594D; /* El color solicitado (Oscuro Menta/Verde) */
      --primary-hover: #3c7362; /* Ligeramente más claro para hover */
      --primary-lightest: #f0f4f3; /* Fondo muy claro para selecciones */
      --primary-text: #2E594D; /* Texto e iconos activos */
    }
    
    body {
      background-color: #f3f4f6; 
    }
    
    /* Estilos para el botón principal (Ahora sólido) */
    .btn-primary-gradient {
      background-color: var(--primary-solid); /* Color sólido */
      border: none;
      transition: all 0.3s ease;
      box-shadow: 0 2px 8px -2px rgba(46, 89, 77, 0.4); 
    }
    .btn-primary-gradient:hover {
      background-color: var(--primary-hover); /* Ligeramente más claro en hover */
      box-shadow: 0 4px 12px -2px rgba(46, 89, 77, 0.6);
      transform: translateY(-0.5px);
    }

    /* Estilos para inputs focuseados */
    .input-focus-style:focus {
      border-color: var(--primary-solid); 
      box-shadow: 0 0 0 3px rgba(46, 89, 77, 0.2); 
    }

    /* Clases para reemplazar colores de Tailwind en estados checked/active */
    .check-active {
        border-color: var(--primary-solid);
        background-color: var(--primary-lightest);
        box-shadow: 0 0 0 2px rgba(46, 89, 77, 0.3);
    }
    .text-active {
        color: var(--primary-text);
    }
    .bg-active {
        background-color: var(--primary-solid);
        color: white;
    }
    .bg-lightest {
        background-color: var(--primary-lightest);
    }
  </style>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <div class="p-4 sm:p-6 min-h-screen font-sans"> 
    <div
      x-data="window.conceptFormData"
      x-init="$nextTick(() => {
        apiBaseUrl = window.__API_BASE_URL__ || '';
        const token = localStorage.getItem('access_token');
        if (token) {
          loadCareers();
          loadStudents();
        } else {
          // Use fallback data if no token
          careers = CAREERS.map(c => ({ id: c.code, name: c.name }));
        }
        const urlParams = new URLSearchParams(window.location.search);
        const rawConcept = localStorage.getItem('editingConcept');
        if (urlParams.has('edit') && rawConcept) {
          try {
            const concept = JSON.parse(rawConcept);
            populateForm(concept);
          } catch (e) {
            console.error('Error:', e);
          }
        } else {
          localStorage.removeItem('editingConcept');
        }
      })"
      class="space-y-5 max-w-4xl mx-auto"
    >
      
      <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-5 gap-4 border-b-2 border-[#2E594D]/20">
        <div class="flex items-center gap-4">
          <div class="p-4 bg-gradient-to-br from-[#2E594D] to-[#1e3d35] rounded-2xl shadow-xl border-2 border-[#2E594D]/30">
            <i class="fas fa-file-invoice-dollar text-3xl text-white"></i>
          </div>
          <div>
            <h1 class="text-3xl font-extrabold text-[#2E594D] tracking-tight flex items-center gap-2">
              <span x-text="formData.id ? 'Editar' : 'Nuevo'"></span> Concepto
              <span class="inline-block px-3 py-1 text-xs bg-[#2E594D]/10 text-[#2E594D] rounded-full font-semibold border border-[#2E594D]/20">
                <i class="fas fa-money-bill-wave mr-1"></i>Sistema de Cobros
              </span>
            </h1>
            <p class="text-gray-600 text-sm mt-1">Administración de cargos escolares obligatorios u opcionales</p>
          </div>
        </div>
        
        <div class="flex gap-3 w-full sm:w-auto mt-2 sm:mt-0">
          <button type="button" @click="cancel" class="flex-1 sm:flex-none px-6 py-3 rounded-xl text-gray-700 bg-white border-2 border-gray-300 hover:bg-gray-50 hover:border-gray-400 font-semibold text-sm transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2">
            <i class="fas fa-times"></i>
            <span>Cancelar</span>
          </button>
          <button type="submit" @click="submitForm" class="flex-1 sm:flex-none px-6 py-3 bg-gradient-to-r from-[#2E594D] to-[#1e3d35] text-white rounded-xl font-bold btn-primary-gradient text-sm flex items-center justify-center gap-2 shadow-lg hover:shadow-xl transition-all hover:scale-105">
            <i class="fas fa-save text-base"></i>
            <span x-text="formData.id ? 'Actualizar Concepto' : 'Guardar Concepto'"></span>
          </button>
        </div>
      </header>

      <div x-cloak x-show="errorMessage"
        :class="errorMessage.includes('✓') ? 'bg-emerald-50 text-emerald-800 border-emerald-300' : 'bg-red-50 text-red-800 border-red-300'"
        class="p-4 rounded-xl font-medium text-sm flex items-start border shadow-md"
      >
        <i :class="errorMessage.includes('✓') ? 'fas fa-check-circle text-emerald-500' : 'fas fa-exclamation-triangle text-red-500'" class="text-xl mr-3 mt-0.5"></i>
        <span x-text="errorMessage" class="flex-1"></span>
      </div>

      <form @submit.prevent="submitForm" class="space-y-6">

        <section class="bg-gradient-to-br from-white via-[#2E594D]/5 to-white p-6 rounded-2xl shadow-2xl border-2 border-[#2E594D]/20 space-y-5">
          <div class="flex items-center gap-3 pb-3 border-b-2 border-[#2E594D]/10">
            <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-[#2E594D] to-[#1e3d35] text-white font-extrabold text-sm shadow-lg">
                <i class="fas fa-edit"></i> 
            </span>
            <h2 class="text-xl font-extrabold text-[#2E594D]">Datos del Cargo</h2>
          </div>
          
          <div class="space-y-5">
            
            <div class="grid grid-cols-3 gap-5"> 
              
              <div class="col-span-2"> 
                <label for="title" class="block text-sm font-bold text-gray-800 mb-2 flex items-center gap-2">
                  <i class="fas fa-tag text-[#2E594D]"></i>
                  Título del Concepto
                </label>
                <input type="text" id="title" x-model="formData.title" placeholder="Ej. Inscripción Semestre Feb-Jul"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl input-focus-style transition duration-200 text-sm font-medium shadow-sm hover:border-[#2E594D]/40" required>
              </div>
              
              <div class="col-span-1">
                <label for="amount" class="block text-sm font-bold text-gray-800 mb-2 flex items-center gap-2">
                  <i class="fas fa-dollar-sign text-emerald-600"></i>
                  Monto
                </label>
                <div class="relative">
                  <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500 font-bold text-base">$</span>
                  <input type="number" id="amount" x-model.number="formData.amount" min="0.01" step="0.01" placeholder="0.00"
                    class="w-full px-4 py-3 pl-9 border-2 border-gray-300 rounded-xl input-focus-style transition duration-200 text-sm font-bold shadow-sm hover:border-emerald-400" required>
                </div>
              </div>
            </div>

            <div>
              <label for="description" class="block text-sm font-bold text-gray-800 mb-2 flex items-center gap-2">
                <i class="fas fa-align-left text-[#2E594D]"></i>
                Descripción (Opcional)
              </label>
              <textarea id="description" x-model="formData.description" rows="3" placeholder="Notas relevantes sobre el destino o las condiciones del pago..."
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl input-focus-style transition duration-200 text-sm shadow-sm hover:border-[#2E594D]/40"></textarea>
            </div>
            
            <div class="grid grid-cols-2 gap-5 bg-gray-50 p-4 rounded-xl border-2 border-dashed border-[#2E594D]/20">
              <div>
                <label for="startDate" class="block text-sm font-bold text-gray-800 mb-2 flex items-center gap-2">
                  <i class="fas fa-calendar-check text-blue-600"></i>
                  Fecha de Inicio <span class="text-red-600">*</span>
                </label>
                <input type="date" id="startDate" x-model="formData.startDate"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl input-focus-style transition duration-200 text-sm font-medium shadow-sm hover:border-blue-400" required>
              </div>
              
              <div>
                <label for="endDate" class="block text-sm font-bold text-gray-800 mb-2 flex items-center gap-2">
                  <i class="fas fa-calendar-times text-red-600"></i>
                  Fecha de Fin <span class="text-red-600">*</span>
                </label>
                <input type="date" id="endDate" x-model="formData.endDate"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl input-focus-style transition duration-200 text-sm font-medium shadow-sm hover:border-red-400" required>
              </div>
            </div>
            
          </div>
        </section>


        <section class="bg-gradient-to-br from-white via-blue-50/30 to-white p-6 rounded-2xl shadow-2xl border-2 border-blue-200/50 space-y-5">
          <div class="flex items-center gap-3 pb-3 border-b-2 border-blue-200/50">
            <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 text-white font-extrabold text-sm shadow-lg">
                <i class="fas fa-filter"></i>
            </span>
            <h2 class="text-xl font-extrabold text-blue-900">Reglas de Aplicación (Alcance)</h2>
          </div>

          <div class="grid grid-cols-2 gap-5">
            <div @click="formData.allStudents = true; formData.selectedCareers = []; formData.selectedSemesters = []; formData.selectedSpecificStudents = [];"
              :class="formData.allStudents ? 'check-active ring-4 ring-[#2E594D]/20' : 'border-gray-300 hover:border-gray-400'"
              class="border-2 rounded-2xl p-5 cursor-pointer transition-all flex items-center gap-4 shadow-lg hover:shadow-xl hover:scale-105">
              <div :class="formData.allStudents ? 'bg-active' : 'bg-gray-200 text-gray-500'" class="p-4 rounded-xl transition">
                <i class="fas fa-users-cog text-2xl"></i>
              </div>
              <div>
                <p class="font-extrabold text-gray-950 text-base">Matrícula Completa</p>
                <p class="text-xs text-gray-600 mt-1">Aplica a todos los estudiantes</p>
              </div>
            </div>
            
            <div @click="formData.allStudents = false"
              :class="!formData.allStudents ? 'check-active ring-4 ring-[#2E594D]/20' : 'border-gray-300 hover:border-gray-400'"
              class="border-2 rounded-2xl p-5 cursor-pointer transition-all flex items-center gap-4 shadow-lg hover:shadow-xl hover:scale-105">
              <div :class="!formData.allStudents ? 'bg-active' : 'bg-gray-200 text-gray-500'" class="p-4 rounded-xl transition">
                <i class="fas fa-filter text-2xl"></i>
              </div>
              <div>
                <p class="font-extrabold text-gray-950 text-base">Alcance Restringido</p>
                <p class="text-xs text-gray-600 mt-1">Filtrar por carrera/semestre</p>
              </div>
            </div>
          </div>

          <div x-show="!formData.allStudents" x-cloak x-transition.opacity.duration.300ms class="space-y-4 pt-4">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-gray-50 p-4 rounded-xl border border-gray-200">
              
              <div>
                <label class="block text-xs font-bold text-gray-800 mb-2">1. Filtrar por Programa(s)</label>
                <div x-show="careers.length === 0" class="text-sm text-red-600 mb-2 p-2 bg-red-50 rounded">
                  ⚠️ No se cargaron carreras. Revisa la consola del navegador.
                </div>
                <div x-show="careers.length > 0" class="text-xs text-green-600 mb-2">
                  ✓ <span x-text="careers.length"></span> carreras disponibles
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <template x-for="career in careers" :key="career.id">
                    <label class="cursor-pointer">
                      <input type="checkbox" :value="career.id" x-model="formData.selectedCareers" class="sr-only peer">
                      <div
                        class="p-2 rounded-xl border-2 border-gray-300 text-center flex items-center justify-center min-h-[35px] text-xs transition-all peer-checked:border-[var(--primary-solid)] peer-checked:bg-[var(--primary-lightest)] peer-checked:text-[var(--primary-text)] hover:shadow-md"
                      >
                        <span class="font-semibold" x-text="career.name"></span>
                      </div>
                    </label>
                  </template>
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-800 mb-2">2. Filtrar por Semestre(s)</label>
                <div class="flex flex-wrap gap-2">
                  <template x-for="sem in semesters" :key="sem.id">
                    <label class="cursor-pointer">
                      <input type="checkbox" :value="sem.id" x-model="formData.selectedSemesters" class="sr-only peer">
                      <div
                        class="w-8 h-8 flex items-center justify-center rounded-xl border-2 border-gray-300 text-xs font-bold transition-all peer-checked:border-[var(--primary-solid)] peer-checked:bg-[var(--primary-lightest)] peer-checked:text-[var(--primary-text)] hover:shadow-md"
                      >
                        <span x-text="sem.id + '°'"></span>
                      </div>
                    </label>
                  </template>
                </div>
              </div>
            </div>

            <div class="border-t border-gray-300 pt-4 mt-4">
              <label class="block text-xs font-bold text-gray-800 mb-2">3. Alumnos Adicionales (Inclusión forzada)</label>
              
              <div class="relative" x-data="{ open: false }" @click.away="open = false">
                <input type="text" x-model="searchTerm" @focus="open = true" @input="open = true"
                  placeholder="Buscar por nombre o matrícula..."
                  class="w-full px-3 py-2 border border-gray-300 rounded-xl input-focus-style transition duration-200 text-sm">
                
                <div x-show="open && searchTerm.length > 0 && filteredStudents.length > 0" x-cloak
                  class="absolute z-20 w-full mt-1 bg-white border border-gray-200 rounded-xl shadow-2xl max-h-56 overflow-y-auto p-2 space-y-1">
                  <template x-for="student in filteredStudents" :key="student.id">
                    <div @click="toggleSpecificStudent(student); open = false" class="p-2 hover:bg-gray-50 rounded-lg cursor-pointer text-sm flex justify-between items-center transition">
                      <span x-text="student.name" class="text-gray-800 font-medium"></span>
                      <span x-text="'Matrícula: ' + (student.control || student.id)" class="text-gray-500 text-xs"></span>
                      <i x-show="formData.selectedSpecificStudents.some(s => s.id === student.id)" class="fas fa-check-circle text-active"></i>
                    </div>
                  </template>
                </div>
              </div>

              <div class="flex flex-wrap gap-2 mt-3" x-show="formData.selectedSpecificStudents.length > 0" x-transition.slide.up>
                <template x-for="student in formData.selectedSpecificStudents" :key="student.id">
                  <div class="flex items-center gap-2 bg-lightest text-active px-2 py-1 rounded-full text-xs font-semibold border border-[var(--primary-lightest)] shadow-sm">
                    <span x-text="student.name + ' (Matrícula: ' + (student.control || student.id) + ')'"}></span>
                    <button type="button" @click="removeSpecificStudent(student.id)" class="text-active hover:text-red-500 transition focus:outline-none">
                      <i class="fas fa-times-circle text-xs"></i>
                    </button>
                  </div>
                </template>
              </div>
            </div>
          </div>
        </section>

        <section class="bg-gradient-to-br from-white via-purple-50/30 to-white p-6 rounded-2xl shadow-2xl border-2 border-purple-200/50 space-y-5">
          <div class="flex items-center gap-3 pb-3 border-b-2 border-purple-200/50">
            <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-purple-500 to-purple-700 text-white font-extrabold text-sm shadow-lg">
                <i class="fas fa-toggle-on"></i>
            </span>
            <h2 class="text-xl font-extrabold text-purple-900">Estado y Aplicación</h2>
          </div>
          
          <div class="grid grid-cols-2 gap-5">
            <label class="cursor-pointer">
              <input type="radio" name="status" value="active" x-model="formData.status" class="sr-only peer">
              <div class="p-6 rounded-2xl border-2 border-gray-300 peer-checked:border-emerald-500 peer-checked:bg-emerald-50 peer-checked:shadow-xl transition-all text-center flex flex-col items-center gap-2 shadow-lg hover:shadow-xl hover:scale-105">
                <i class="fas fa-check-circle text-4xl transition" :class="formData.status === 'active' ? 'text-emerald-600' : 'text-gray-400'"></i>
                <p class="font-extrabold text-gray-950 text-base mt-2">Concepto Activo</p>
                <p class="text-xs text-gray-600">Visible para estudiantes</p>
              </div>
            </label>
            
            <label class="cursor-pointer">
              <input type="radio" name="status" value="inactive" x-model="formData.status" class="sr-only peer">
              <div class="p-6 rounded-2xl border-2 border-gray-300 peer-checked:border-gray-500 peer-checked:bg-gray-100 peer-checked:shadow-xl transition-all text-center flex flex-col items-center gap-2 shadow-lg hover:shadow-xl hover:scale-105">
                <i class="fas fa-pause-circle text-4xl transition" :class="formData.status === 'inactive' ? 'text-gray-600' : 'text-gray-400'"></i>
                <p class="font-extrabold text-gray-950 text-base mt-2">Concepto Inactivo</p>
                <p class="text-xs text-gray-600">No visible para estudiantes</p>
              </div>
            </label>
          </div>
        </section>

      </form>
    </div>
  </div>

  <script type="module" client:load>
    // Inicialización y utilidades de almacenamiento local (simulación de base de datos)
    (function () {
      
      window.getStudents = () => JSON.parse(localStorage.getItem('studentsList') || '[]');
      window.saveStudents = (students) => localStorage.setItem('studentsList', JSON.stringify(students));
      window.getConcepts = () => JSON.parse(localStorage.getItem('conceptsList') || '[]');
      window.getCharges = () => JSON.parse(localStorage.getItem('chargesList') || '[]');
      window.saveCharges = (charges) => localStorage.setItem('chargesList', JSON.stringify(charges));

      /**
       * Determina qué estudiantes cumplen con las reglas de alcance del concepto.
       */
      window.getTargetStudentsForConcept = (concept) => {
        const students = window.getStudents();
        const activeStudents = students.filter(s => (s.status || '').toLowerCase() !== 'inactive' && (s.status || '').toLowerCase() !== 'inactivo');
        const rules = concept.scopeRules;

        if (rules.allStudents) return activeStudents;

        // LÓGICA CORREGIDA PARA EXCLUSIVIDAD
        // 1. Si hay estudiantes específicos, devolver SOLO a esos.
        if (rules.specificStudents.length > 0) {
            return activeStudents.filter(alumno => {
                // *** CORRECCIÓN APLICADA AQUÍ ***
            // Se usa la misma lógica de prioridad que en Alpine (userId ?? id ?? numControl) para coincidir con la lista de IDs seleccionados.
            const alumnoId = String(alumno.userId ?? alumno.id ?? alumno.numControl ?? alumno.n_control ?? ''); 
                return rules.specificStudents.includes(alumnoId);
            });
        }
        
        // 2. Si no hay estudiantes específicos, aplicar los filtros de Carrera Y Semestre.
        return activeStudents.filter(alumno => {
            let cumpleCareers = true;
            let cumpleSemesters = true;
            
            const alumnoCareer = String(alumno.career_id ?? alumno.careerId ?? alumno.career ?? alumno.carrera ?? '');
            const alumnoSemester = String(alumno.semester ?? alumno.semestre ?? '');

            if (rules.careers.length > 0) {
                cumpleCareers = rules.careers.includes(alumnoCareer);
            }
            
            if (rules.semesters.length > 0) {
                cumpleSemesters = rules.semesters.includes(alumnoSemester);
            }
            
            // Debe cumplir AMBOS filtros (Carrera Y Semestre)
            return cumpleCareers && cumpleSemesters;
        });
      };

      /**
       * Recalcula el adeudo total pendiente de cada estudiante basado en chargesList.
       */
      window.recalcStudentAdeudosFromCharges = () => {
        const charges = window.getCharges();
        const students = window.getStudents();
        const pendingChargesByStudent = {};
        
        charges.forEach(ch => {
          if ((ch.status || '').toLowerCase() === 'pending' || (ch.status || '').toLowerCase() === 'pendiente') {
            const sid = String(ch.studentId);
            pendingChargesByStudent[sid] = (pendingChargesByStudent[sid] || 0) + Number(ch.amount || 0);
          }
        });

        const updated = students.map(s => {
          s.adeudo = parseFloat((pendingChargesByStudent[String(s.id)] || 0).toFixed(2));
          return s;
        });
        window.saveStudents(updated);
      };

      /**
       * Crea nuevos cargos pendientes para los estudiantes que cumplen con el alcance del concepto.
       */
      window.assignConceptToScope = (concept) => {
        const targets = window.getTargetStudentsForConcept(concept);
        if (!targets || targets.length === 0) return 0;

        const amount = Number(concept.amount) || 0;
        const existingCharges = window.getCharges();
        const nowIso = new Date().toISOString();

        const toAdd = targets.reduce((acc, s) => {
          const exists = existingCharges.some(ec =>
            ec.conceptId === concept.id &&
            String(ec.studentId) === String(s.id) &&
            ((ec.status || '').toLowerCase() === 'pending' || (ec.status || '').toLowerCase() === 'pendiente')
          );

          if (!exists) {
            acc.push({
              id: 'chg_' + (Date.now().toString(36) + Math.random().toString(36).slice(2,6)),
              studentId: s.id,
              conceptId: concept.id,
              amount,
              status: 'pending',
              title: concept.title,
              createdAt: nowIso
            });
          }
          return acc;
        }, []);

        if (toAdd.length === 0) return 0;

        window.saveCharges(existingCharges.concat(toAdd));
        window.recalcStudentAdeudosFromCharges();
        
        return toAdd.length;
      };
      
    })();
    </script>
</Layout>