---
import LayoutEstu from '../../layouts/LayoutEstu.astro';
---

<LayoutEstu title="Mi Perfil">
    <div x-data="perfilEstudianteData" x-cloak class="max-w-4xl mx-auto">
        <!-- Encabezado -->
        <div class="flex items-center gap-6 mb-8">
            <div class="w-24 h-24 bg-institucional rounded-full flex items-center justify-center shadow-lg">
                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <div>
                <h1 class="text-4xl font-bold text-institucional mb-2" x-text="studentName || 'Cargando...'"></h1>
                <p class="text-gray-600 text-lg">Estudiante</p>
                <p class="text-gray-500 text-sm mt-1" x-text="'Correo: ' + (studentEmail || 'No disponible')"></p>
            </div>
        </div>

        <!-- Tarjeta de Informaci�n Acad�mica -->
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="bg-institucional text-white p-6 flex items-center gap-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C6.5 6.253 2 10.998 2 17.25m20-11.002c5.5 0 10 4.748 10 11.002M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h2 class="text-2xl font-bold">Informaci�n Acad�mica</h2>
            </div>
            
            <div class="p-8">
                <div class="grid md:grid-cols-3 gap-8">
                    <!-- Informaci�n Personal -->
                    <div>
                        <h3 class="text-xl font-bold text-institucional mb-6">Datos Personales</h3>
                        
                        <div class="space-y-4">
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Nombre Completo</label>
                                <p class="text-lg mt-1" x-text="studentName || 'No disponible'"></p>
                            </div>
                            
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Correo Electr�nico</label>
                                <p class="text-lg mt-1" x-text="studentEmail || 'No disponible'"></p>
                            </div>
                            
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Matr�cula</label>
                                <p class="text-lg mt-1 font-mono text-gray-600" x-text="studentId || 'No disponible'"></p>
                            </div>
                        </div>
                    </div>

                    <!-- Informaci�n de Estatus -->
                    <div>
                        <h3 class="text-xl font-bold text-institucional mb-6">Estatus de Cuenta</h3>
                        
                        <div class="space-y-4">
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Estado de Estudio</label>
                                <div class="mt-1">
                                    <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-semibold">Activo</span>
                                </div>
                            </div>
                            
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">�ltimo Acceso</label>
                                <p class="text-lg mt-1" x-text="lastLogin"></p>
                            </div>
                            
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Nivel de Verificaci�n</label>
                                <div class="mt-2 flex items-center gap-2">
                                    <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 013.066-3.066zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                    </svg>
                                    <span class="text-green-700 font-medium">Verificado</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Informacion Academica -->
                    <div>
                        <h3 class="text-xl font-bold text-institucional mb-6">Informacion Academica</h3>
                        
                        <div class="space-y-4">
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Numero de Control</label>
                                <p class="text-lg mt-1 font-mono text-gray-700" x-text="nControl"></p>
                            </div>
                            
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Semestre</label>
                                <p class="text-lg mt-1" x-text="semestre"></p>
                            </div>
                            
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Grupo</label>
                                <p class="text-lg mt-1" x-text="group"></p>
                            </div>

                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Taller</label>
                                <p class="text-lg mt-1" x-text="workshop"></p>
                            </div>

                            <div class="border rounded-lg p-4 bg-gray-50">
                                <label class="text-sm font-semibold text-gray-600">Carrera</label>
                                <p class="text-lg mt-1" x-text="careerName"></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta de Resumen Financiero -->
        <div class="bg-white rounded-xl shadow-lg overflow-hidden mt-8">
            <div class="bg-institucional text-white p-6 flex items-center gap-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h2 class="text-2xl font-bold">Estado de Pagos</h2>
            </div>
            
            <div class="p-8">
                <div class="grid md:grid-cols-3 gap-6">
                    <!-- Pagos Pendientes -->
                    <div class="bg-red-50 rounded-lg p-6 border border-red-200">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-600 text-sm font-semibold">Pagos Pendientes</p>
                                <p class="text-3xl font-bold text-red-600 mt-2" x-text="pendingPayments"></p>
                            </div>
                            <svg class="w-12 h-12 text-red-600 opacity-20" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M13.477 14.89A6 6 0 015.11 2.526a6 6 0 008.367 8.368z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                    </div>

                    <!-- Pagos Realizados -->
                    <div class="bg-green-50 rounded-lg p-6 border border-green-200">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-600 text-sm font-semibold">Pagos Realizados</p>
                                <p class="text-3xl font-bold text-green-600 mt-2" x-text="completedPayments"></p>
                            </div>
                            <svg class="w-12 h-12 text-green-600 opacity-20" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                    </div>

                    <!-- Deuda Total -->
                    <div class="bg-blue-50 rounded-lg p-6 border border-blue-200">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-600 text-sm font-semibold">Deuda Total</p>
                                <p class="text-3xl font-bold text-blue-600 mt-2" x-text="totalDebt"></p>
                            </div>
                            <svg class="w-12 h-12 text-blue-600 opacity-20" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.414l4.293 4.293a1 1 0 01.117 1.32l-1.414 1.414a1 1 0 00-.115 1.319l5.553 5.553a2 2 0 01-2.828 2.828l-5.553-5.553a1 1 0 00-1.319.115l-1.414 1.414a1 1 0 01-1.32-.117L6.414 12H6a2 2 0 01-2-2V4z"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones de Acci�n -->
        <div class="flex flex-wrap gap-4 mt-8 mb-8">
            <button @click="editProfile()" class="px-6 py-3 bg-institucional text-white font-semibold rounded-lg hover:opacity-90 transition-all flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                Editar Perfil
            </button>
            <button @click="changePassword()" class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:opacity-90 transition-all flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.97 5.95m-2.02-2.02a7 7 0 10-9.95 9.95" />
                </svg>
                Cambiar Contrase�a
            </button>
            <a href="/Estudiante/PortalEstudiante" class="px-6 py-3 bg-gray-600 text-white font-semibold rounded-lg hover:opacity-90 transition-all flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Atr�s
            </a>
        </div>
    </div>

    <!-- Modal de Edición de Perfil -->
    <div x-show="showEditModal" @click="$event.target === $el && closeAllModals()" @keydown.escape.window="closeAllModals()" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-xl max-w-2xl w-full p-8 my-8">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold text-institucional">Editar Perfil</h3>
                <button @click="closeAllModals()" class="text-gray-500 hover:text-gray-700">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form @submit.prevent="updateProfile()" class="space-y-6">
                <!-- Nombre y Apellido -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Nombre</label>
                        <input 
                            type="text" 
                            x-model="formData.name" 
                            placeholder="Tu nombre"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                        >
                        <template x-if="errors.name">
                            <p class="text-red-500 text-sm mt-1" x-text="errors.name[0]"></p>
                        </template>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Apellido</label>
                        <input 
                            type="text" 
                            x-model="formData.last_name" 
                            placeholder="Tu apellido"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                        >
                        <template x-if="errors.last_name">
                            <p class="text-red-500 text-sm mt-1" x-text="errors.last_name[0]"></p>
                        </template>
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Correo Electr�nico</label>
                    <input 
                        type="email" 
                        x-model="formData.email" 
                        placeholder="tu@email.com"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                    >
                    <template x-if="errors.email">
                        <p class="text-red-500 text-sm mt-1" x-text="errors.email[0]"></p>
                    </template>
                </div>

                <!-- Tel�fono -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Tel�fono</label>
                    <input 
                        type="tel" 
                        x-model="formData.phone_number" 
                        placeholder="+5215512345678"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                    >
                    <template x-if="errors.phone_number">
                        <p class="text-red-500 text-sm mt-1" x-text="errors.phone_number[0]"></p>
                    </template>
                </div>

                <!-- Fecha de Nacimiento y G�nero -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Fecha de Nacimiento</label>
                        <input 
                            type="date" 
                            x-model="formData.birthdate"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                        >
                        <template x-if="errors.birthdate">
                            <p class="text-red-500 text-sm mt-1" x-text="errors.birthdate[0]"></p>
                        </template>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">G�nero</label>
                        <select x-model="formData.gender" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none">
                            <option value="">Selecciona...</option>
                            <option value="male">Masculino</option>
                            <option value="female">Femenino</option>
                            <option value="other">Otro</option>
                        </select>
                        <template x-if="errors.gender">
                            <p class="text-red-500 text-sm mt-1" x-text="errors.gender[0]"></p>
                        </template>
                    </div>
                </div>

                <!-- Tipo de Sangre -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Tipo de Sangre</label>
                    <select x-model="formData.blood_type" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none">
                        <option value="">Selecciona...</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                    </select>
                    <template x-if="errors.blood_type">
                        <p class="text-red-500 text-sm mt-1" x-text="errors.blood_type[0]"></p>
                    </template>
                </div>

                <!-- Direcci�n -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Direcci�n</label>
                    <input 
                        type="text" 
                        x-model="formData.address" 
                        placeholder="Tu direcci�n"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                    >
                    <template x-if="errors.address">
                        <p class="text-red-500 text-sm mt-1" x-text="errors.address[0]"></p>
                    </template>
                </div>

                <!-- Mensajes de Estado -->
                <template x-if="successMessage">
                    <div class="p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
                        <p x-text="successMessage"></p>
                    </div>
                </template>

                <template x-if="errorMessage">
                    <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
                        <p x-text="errorMessage"></p>
                    </div>
                </template>

                <!-- Botones de Acci�n -->
                <div class="flex gap-4 justify-end pt-6 border-t">
                    <button 
                        type="button"
                        @click="closeAllModals()" 
                        class="px-6 py-2 bg-gray-300 text-gray-800 font-semibold rounded-lg hover:bg-gray-400 transition-all"
                    >
                        Cancelar
                    </button>
                    <button 
                        type="submit"
                        :disabled="isUpdating"
                        class="px-6 py-2 bg-institucional text-white font-semibold rounded-lg hover:opacity-90 transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"
                    >
                        <span x-show="!isUpdating">Guardar Cambios</span>
                        <span x-show="isUpdating">Guardando...</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal de Cambiar Contraseña -->
    <div x-show="showPasswordModal" @click="$event.target === $el && closeAllModals()" @keydown.escape.window="closeAllModals()" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-xl max-w-md w-full p-8 my-8">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold text-institucional">Cambiar Contraseña</h3>
                <button @click="closeAllModals()" class="text-gray-500 hover:text-gray-700">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form @submit.prevent="submitChangePassword()" class="space-y-6">
                <!-- Contraseña Actual -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Contraseña Actual</label>
                    <input 
                        type="password" 
                        x-model="passwordData.currentPassword" 
                        placeholder="Tu contraseña actual"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                    >
                    <template x-if="passwordErrors.currentPassword">
                        <p class="text-red-500 text-sm mt-1" x-text="passwordErrors.currentPassword[0]"></p>
                    </template>
                </div>

                <!-- Nueva Contraseña -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Nueva Contraseña</label>
                    <input 
                        type="password" 
                        x-model="passwordData.newPassword" 
                        placeholder="Mínimo 8 caracteres"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                    >
                    <template x-if="passwordErrors.newPassword">
                        <p class="text-red-500 text-sm mt-1" x-text="passwordErrors.newPassword[0]"></p>
                    </template>
                </div>

                <!-- Confirmar Contraseña -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Confirmar Contraseña</label>
                    <input 
                        type="password" 
                        x-model="passwordData.confirmPassword" 
                        placeholder="Confirma tu nueva contraseña"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institucional focus:outline-none"
                    >
                </div>

                <!-- Mensajes de Estado -->
                <template x-if="passwordSuccessMessage">
                    <div class="p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
                        <p x-text="passwordSuccessMessage"></p>
                    </div>
                </template>

                <template x-if="passwordErrorMessage">
                    <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
                        <p x-text="passwordErrorMessage"></p>
                    </div>
                </template>

                <!-- Botones de Acción -->
                <div class="flex gap-4 justify-end pt-6 border-t">
                    <button 
                        type="button"
                        @click="closeAllModals()" 
                        class="px-6 py-2 bg-gray-300 text-gray-800 font-semibold rounded-lg hover:bg-gray-400 transition-all"
                    >
                        Cancelar
                    </button>
                    <button 
                        type="submit"
                        :disabled="isChangingPassword"
                        class="px-6 py-2 bg-institucional text-white font-semibold rounded-lg hover:opacity-90 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        <span x-show="!isChangingPassword">Cambiar Contraseña</span>
                        <span x-show="isChangingPassword">Procesando...</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script is:inline define:vars={{API_BASE_URL: 'https://nginx-production-728f.up.railway.app/api'}}>
        document.addEventListener('alpine:init', () => {
            Alpine.data('perfilEstudianteData', () => ({
                studentName: '',
                studentEmail: '',
                studentId: '',
                lastLogin: '',
                nControl: '',
                semestre: '',
                group: '',
                workshop: '',
                careerName: '',
                pendingPayments: '0',
                completedPayments: '0',
                totalDebt: '\$0.00',
                showEditModal: false,
                showPasswordModal: false,
                isUpdating: false,
                successMessage: '',
                errorMessage: '',
                errors: {},
                formData: {
                    name: '',
                    last_name: '',
                    email: '',
                    phone_number: '',
                    birthdate: '',
                    gender: '',
                    blood_type: '',
                    address: ''
                },

                passwordData: {
                    currentPassword: '',
                    newPassword: '',
                    confirmPassword: ''
                },
                passwordErrors: {},
                isChangingPassword: false,
                passwordSuccessMessage: '',
                passwordErrorMessage: '',

                init() {
                    this.loadStudentData();
                    this.loadStudentDetails();
                },

                async loadStudentData() {
                    const token = localStorage.getItem('access_token');
                    console.log('🔍 Loading student data - Token status:', token ? '✅ Present' : '❌ Missing');
                    
                    if (!token) {
                        console.log('No token found, using localStorage fallback');
                        this.loadStudentDataFromStorage();
                        return;
                    }

                    try {
                        const response = await fetch(API_BASE_URL + '/v1/users/user', {
                            method: 'GET',
                            headers: {
                                'Authorization': 'Bearer ' + token,
                                'Accept': 'application/json'
                            }
                        });

                        if (response.ok) {
                            const data = await response.json();
                            if (data.success && data.data?.user) {
                                const student = data.data.user;
                                localStorage.setItem('user_data', JSON.stringify(student));
                                this.populateStudentData(student);
                                console.log('Student data loaded from API');
                            } else {
                                console.log('Invalid API response, using localStorage fallback');
                                this.loadStudentDataFromStorage();
                            }
                        } else if (response.status === 401 || response.status === 403) {
                            console.log('Unauthorized, using localStorage fallback');
                            this.loadStudentDataFromStorage();
                        } else {
                            console.log('API error, using localStorage fallback');
                            this.loadStudentDataFromStorage();
                        }
                    } catch (err) {
                        console.error('Error fetching student data from API:', err);
                        console.log('Using localStorage fallback');
                        this.loadStudentDataFromStorage();
                    }
                },

                loadStudentDataFromStorage() {
                    const userData = localStorage.getItem('user_data');
                    console.log('📦 Checking localStorage - user_data status:', userData ? '✅ Found' : '❌ Missing');
                    
                    if (!userData) {
                        console.log('No student data found');
                        return;
                    }

                    try {
                        const student = JSON.parse(userData);
                        console.log('👤 Parsed student data:', { id: student.id, name: student.name, email: student.email });
                        this.populateStudentData(student);
                    } catch (e) {
                        console.error('Error parsing student data:', e);
                    }
                },

                async loadStudentDetails() {
                    const token = localStorage.getItem('access_token');
                    console.log('🔍 Loading student details - Token status:', token ? '✅ Present' : '❌ Missing');
                    
                    if (!token) {
                        console.log('No token found, using localStorage fallback for student details');
                        this.loadStudentDetailsFromStorage();
                        return;
                    }

                    try {
                        const response = await fetch(API_BASE_URL + '/v1/users/student-details', {
                            method: 'GET',
                            headers: {
                                'Authorization': 'Bearer ' + token,
                                'Accept': 'application/json'
                            }
                        });

                        if (response.ok) {
                            const data = await response.json();
                            if (data.success && data.data?.student_details) {
                                const details = data.data.student_details;
                                localStorage.setItem('student_details', JSON.stringify(details));
                                this.populateStudentDetails(details);
                                console.log('Student details loaded from API');
                            } else {
                                console.log('Invalid API response for student details, using localStorage fallback');
                                this.loadStudentDetailsFromStorage();
                            }
                        } else if (response.status === 401 || response.status === 403 || response.status === 404) {
                            console.log('Unauthorized or not found, using localStorage fallback');
                            this.loadStudentDetailsFromStorage();
                        } else {
                            console.log('API error, using localStorage fallback');
                            this.loadStudentDetailsFromStorage();
                        }
                    } catch (err) {
                        console.error('Error fetching student details from API:', err);
                        console.log('Using localStorage fallback');
                        this.loadStudentDetailsFromStorage();
                    }
                },

                loadStudentDetailsFromStorage() {
                    const detailsData = localStorage.getItem('student_details');
                    console.log('📦 Checking localStorage - student_details status:', detailsData ? '✅ Found' : '❌ Missing');
                    
                    if (!detailsData) {
                        console.log('No student details found in storage');
                        return;
                    }

                    try {
                        const details = JSON.parse(detailsData);
                        console.log('🎓 Parsed student details:', { nControl: details.nControl, semestre: details.semestre });
                        this.populateStudentDetails(details);
                    } catch (e) {
                        console.error('Error parsing student details:', e);
                    }
                },

                populateStudentDetails(details) {
                    this.nControl = details.nControl || 'No disponible';
                    this.semestre = details.semestre ? 'Semestre ' + details.semestre : 'No disponible';
                    this.group = details.group || 'No disponible';
                    this.workshop = details.workshop || 'No disponible';
                    this.careerName = details.careerName || 'No disponible';

                    console.log('Student details populated:', {
                        nControl: this.nControl,
                        semestre: this.semestre,
                        group: this.group,
                        workshop: this.workshop,
                        careerName: this.careerName
                    });
                },

                populateStudentData(student) {
                    this.studentName = student.name || student.username || 'Sin nombre';
                    this.studentEmail = student.email || 'No disponible';
                    this.studentId = student.id || 'No disponible';
                    
                    this.lastLogin = new Date().toLocaleDateString('es-ES', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });

                    // Valores de ejemplo - pueden ser actualizados con datos reales de la API
                    this.pendingPayments = student.pendingPayments || '0';
                    this.completedPayments = student.completedPayments || '0';
                    this.totalDebt = student.totalDebt || '$0.00';

                    // Populate form data
                    this.formData.name = student.name || '';
                    this.formData.last_name = student.last_name || '';
                    this.formData.email = student.email || '';
                    this.formData.phone_number = student.phone_number || '';
                    this.formData.birthdate = student.birthdate || '';
                    this.formData.gender = student.gender || '';
                    this.formData.blood_type = student.blood_type || '';
                    this.formData.address = Array.isArray(student.address) && student.address[0] ? student.address[0] : '';

                    console.log('Student data populated:', {
                        name: this.studentName,
                        email: this.studentEmail,
                        id: this.studentId
                    });
                },

                closeAllModals() {
                    this.showEditModal = false;
                    this.showPasswordModal = false;
                },

                editProfile() {
                    this.closeAllModals();
                    this.showEditModal = true;
                },

                changePassword() {
                    this.closeAllModals();
                    this.showPasswordModal = true;
                    this.passwordData = { currentPassword: '', newPassword: '', confirmPassword: '' };
                    this.passwordErrors = {};
                    this.passwordSuccessMessage = '';
                    this.passwordErrorMessage = '';
                },

                async submitChangePassword() {
                    this.isChangingPassword = true;
                    this.passwordSuccessMessage = '';
                    this.passwordErrorMessage = '';
                    this.passwordErrors = {};

                    // Validación del lado del cliente
                    if (!this.passwordData.currentPassword) {
                        this.passwordErrorMessage = 'La contraseña actual es requerida';
                        this.isChangingPassword = false;
                        return;
                    }

                    if (!this.passwordData.newPassword) {
                        this.passwordErrorMessage = 'La nueva contraseña es requerida';
                        this.isChangingPassword = false;
                        return;
                    }

                    if (this.passwordData.newPassword.length < 8) {
                        this.passwordErrorMessage = 'La contraseña debe tener al menos 8 caracteres';
                        this.isChangingPassword = false;
                        return;
                    }

                    if (this.passwordData.newPassword !== this.passwordData.confirmPassword) {
                        this.passwordErrorMessage = 'Las contraseñas no coinciden';
                        this.isChangingPassword = false;
                        return;
                    }

                    const token = localStorage.getItem('access_token');
                    if (!token) {
                        this.passwordErrorMessage = 'No estás autenticado. Por favor inicia sesión.';
                        this.isChangingPassword = false;
                        return;
                    }

                    try {
                        const response = await fetch(API_BASE_URL + '/v1/users/update/password', {
                            method: 'PATCH',
                            headers: {
                                'Authorization': 'Bearer ' + token,
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({
                                currentPassword: this.passwordData.currentPassword,
                                newPassword: this.passwordData.newPassword
                            })
                        });

                        const data = await response.json();

                        if (response.ok && data.success) {
                            this.passwordSuccessMessage = data.message || 'Contraseña actualizada correctamente';
                            
                            setTimeout(() => {
                                this.showPasswordModal = false;
                                this.passwordData = { currentPassword: '', newPassword: '', confirmPassword: '' };
                                this.passwordSuccessMessage = '';
                            }, 2000);
                        } else {
                            if (data.errors) {
                                this.passwordErrors = data.errors;
                                const firstErrorKey = Object.keys(data.errors)[0];
                                const firstError = data.errors[firstErrorKey];
                                this.passwordErrorMessage = Array.isArray(firstError) ? firstError[0] : firstError;
                            } else if (response.status === 400) {
                                this.passwordErrorMessage = 'La contraseña actual es incorrecta';
                            } else {
                                this.passwordErrorMessage = data.message || 'Error al cambiar la contraseña';
                            }
                        }
                    } catch (err) {
                        console.error('Error changing password:', err);
                        this.passwordErrorMessage = 'Error de conexión con el servidor';
                    } finally {
                        this.isChangingPassword = false;
                    }
                },

                async updateProfile() {
                    this.isUpdating = true;
                    this.successMessage = '';
                    this.errorMessage = '';
                    this.errors = {};

                    const token = localStorage.getItem('access_token');
                    if (!token) {
                        this.errorMessage = 'No est�s autenticado. Por favor inicia sesi�n.';
                        this.isUpdating = false;
                        return;
                    }

                    const requestData = {
                        name: this.formData.name,
                        last_name: this.formData.last_name,
                        email: this.formData.email,
                        phone_number: this.formData.phone_number,
                        birthdate: this.formData.birthdate,
                        gender: this.formData.gender,
                        blood_type: this.formData.blood_type
                    };

                    if (this.formData.address) {
                        requestData.address = [this.formData.address];
                    }

                    try {
                        const response = await fetch(API_BASE_URL + '/v1/users/update', {
                            method: 'PATCH',
                            headers: {
                                'Authorization': 'Bearer ' + token,
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify(requestData)
                        });

                        const data = await response.json();

                        if (response.ok && data.success) {
                            this.successMessage = data.message || 'Perfil actualizado correctamente';
                            const updatedUser = data.data.user;
                            localStorage.setItem('user_data', JSON.stringify(updatedUser));
                            this.studentName = updatedUser.name || updatedUser.username || 'Sin nombre';
                            this.studentEmail = updatedUser.email || 'No disponible';
                            
                            setTimeout(() => {
                                this.showEditModal = false;
                                this.successMessage = '';
                            }, 2000);
                        } else {
                            if (data.errors) {
                                this.errors = data.errors;
                                const firstErrorKey = Object.keys(data.errors)[0];
                                const firstError = data.errors[firstErrorKey];
                                this.errorMessage = Array.isArray(firstError) ? firstError[0] : firstError;
                            } else {
                                this.errorMessage = data.message || 'Error al actualizar el perfil';
                            }
                        }
                    } catch (err) {
                        console.error('Error updating profile:', err);
                        this.errorMessage = 'Error de conexi�n con el servidor';
                    } finally {
                        this.isUpdating = false;
                    }
                }
            }));
        });
    </script>

    <style is:global>
        [x-cloak] { display: none !important; }
    </style>
</LayoutEstu>
