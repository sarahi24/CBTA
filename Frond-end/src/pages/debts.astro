---
import Layout from "../layouts/Layout.astro";

const pageTitle = "Estado de Adeudos - CBTA 71";

// Note: Data will be loaded client-side with authentication
const debts = [];
const students = [];

const debtsJSON = JSON.stringify(debts);
const studentsJSON = JSON.stringify(students);

const CAREER_MAP = {
  'TAG-E': 'Técnico Agropecuario',
  'TOF': 'Técnico en Ofimática',
  'TEM': 'Técnico en Admón. de Emprendimiento',
  'TAG-M': 'Técnico Agropecuario (Mixta)',
  'TRH': 'Técnico en Admón. de Recursos Humanos (Mixta)',
  '': 'Sin Carrera'
};

const careerMapJSON = JSON.stringify(CAREER_MAP);
---
<Layout title={pageTitle}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 bg-gradient-to-br from-gray-50 via-white to-[#2E594D]/5 min-h-screen">
    
    <header class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6 mb-10 pb-6 bg-white rounded-2xl shadow-lg px-6 py-5">
      <div class="flex items-center gap-4 w-full justify-start">
        <div class="p-4 bg-gradient-to-br from-[#2D584C] to-[#1e3d35] rounded-2xl shadow-xl shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V6m0 4v2m0 2v2m0 0V4m-7 8a7 7 0 1114 0 7 7 0 01-14 0z" />
          </svg>
        </div>
        <div class="text-left">
          <h1 class="text-3xl font-black text-[#2D584C] tracking-tight leading-none text-left flex items-center gap-3">
            Estado de Adeudos
            <span class="text-xs bg-[#2D584C]/10 text-[#2D584C] px-3 py-1 rounded-full font-semibold">Gestión Financiera</span>
          </h1>
          <p class="text-sm text-gray-600 mt-2 font-medium text-left flex items-center gap-2">
            <i class="fas fa-info-circle text-[#2D584C]"></i>
            Cargos pendientes por cobrar y gestión de pagos
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto justify-start lg:justify-end">
        <div class="relative w-full lg:w-[320px]">
          <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
          <input type="text" id="search-input" placeholder="Buscar alumno por nombre o matrícula..." class="w-full pl-11 pr-4 h-[48px] border-2 border-gray-200 rounded-xl text-sm outline-none focus:border-[#2D584C] focus:ring-4 focus:ring-[#2D584C]/10 bg-white shadow-sm transition-all" />
        </div>
        <button id="refresh-debts-btn" class="h-[48px] px-5 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl shadow-lg hover:shadow-xl hover:scale-105 transition-all flex items-center justify-center text-xs font-bold gap-2 shrink-0">
          <i class="fas fa-sync-alt"></i>
          <span>Actualizar</span>
        </button>
        <button id="open-pay-modal-btn" class="h-[48px] px-5 bg-gradient-to-r from-[#2D584C] to-[#1e3d35] text-white rounded-xl shadow-lg hover:shadow-xl hover:scale-105 transition-all flex items-center justify-center text-xs font-bold gap-2 shrink-0">
          <i class="fas fa-dollar-sign"></i>
          <span>Registrar Pago</span>
        </button>
        <button id="open-validate-modal-btn" class="h-[48px] px-5 bg-gradient-to-r from-purple-600 to-purple-700 text-white rounded-xl shadow-lg hover:shadow-xl hover:scale-105 transition-all flex items-center justify-center text-xs font-bold gap-2 shrink-0">
          <i class="fas fa-check-circle"></i>
          <span>Validar Pago</span>
        </button>
      </div>
    </header>

    <div class="bg-gradient-to-br from-white via-[#2D584C]/5 to-white rounded-2xl shadow-2xl border-2 border-[#2D584C]/20 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full border-collapse">
          <thead class="bg-gradient-to-r from-[#2D584C] to-[#1e3d35]">
            <tr>
              <th class="px-8 py-5 text-left text-xs font-black text-white uppercase tracking-wider">
                <div class="flex items-center gap-2">
                  <i class="fas fa-user-graduate"></i>
                  <span>Estudiante</span>
                </div>
              </th>
              <th class="px-8 py-5 text-left text-xs font-black text-white uppercase tracking-wider">
                <div class="flex items-center gap-2">
                  <i class="fas fa-file-invoice"></i>
                  <span>Concepto</span>
                </div>
              </th>
              <th class="px-8 py-5 text-right text-xs font-black text-white uppercase tracking-wider">
                <div class="flex items-center justify-end gap-2">
                  <i class="fas fa-dollar-sign"></i>
                  <span>Monto</span>
                </div>
              </th>
            </tr>
          </thead>
          <tbody id="payments-table-body" class="bg-white divide-y divide-gray-100"></tbody>
        </table>
      </div>

      <div class="px-8 py-5 bg-gradient-to-r from-gray-50 to-gray-100 border-t-2 border-[#2D584C]/10 flex flex-col sm:flex-row justify-between items-center gap-4">
        <span id="pagination-info" class="text-xs font-bold text-[#2D584C] flex items-center gap-2">
          <i class="fas fa-list"></i>
          <span>Mostrando 0 de 0 adeudos</span>
        </span>
        <div class="flex items-center gap-2" id="pagination-buttons"></div>
      </div>
    </div>
  </div>

  <div id="pay-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4 text-left">
    <div class="bg-white rounded-3xl w-full max-w-sm p-6 shadow-2xl">
      <div class="flex justify-between items-center mb-4 border-b pb-3">
        <h3 class="text-lg font-black text-gray-900">Registrar Pago</h3>
        <button id="pay-close-x" class="text-gray-400">✕</button>
      </div>
      <form id="pay-form" class="space-y-3">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[9px] font-black text-gray-400 uppercase mb-1">Referencia / Folio</label>
            <input id="pay-code" type="text" placeholder="Ej: 4567" class="w-full border-2 border-gray-100 rounded-lg px-3 py-2 text-xs font-bold uppercase" required />
          </div>
          <div>
            <label class="block text-[9px] font-black text-gray-400 uppercase mb-1">Método</label>
            <select id="pay-method" class="w-full border-2 border-gray-100 rounded-lg px-3 py-2 text-xs font-bold" required>
              <option value="Transferencia">Transferencia</option>
              <option value="Depósito">Depósito</option>
            </select>
          </div>
        </div>
        
        <div class="relative">
          <label class="block text-[9px] font-black text-gray-400 uppercase mb-1">Buscar Alumno</label>
          <input id="pay-student-search" type="text" autocomplete="off" placeholder="Nombre o No. Control..." class="w-full border-2 border-gray-100 rounded-lg px-3 py-2 text-xs" />
          <div id="autocomplete-list" class="absolute z-20 w-full bg-white border rounded-xl mt-1 shadow-2xl max-h-40 overflow-y-auto hidden"></div>
        </div>

        <div id="selected-student-info" class="hidden p-3 bg-emerald-50 border border-emerald-100 rounded-lg">
            <div id="display-student-name" class="text-[11px] font-black text-[#2D584C] uppercase"></div>
            <div id="display-student-control" class="text-[9px] font-mono font-bold text-emerald-600/70"></div>
        </div>

        <div>
          <label class="block text-[9px] font-black text-gray-400 uppercase mb-1">Adeudo Correspondiente</label>
          <select id="pay-charge-id" class="w-full border-2 border-gray-100 rounded-lg px-3 py-2 text-xs font-bold disabled:opacity-50" disabled required>
            <option value="">Primero selecciona un alumno</option>
          </select>
        </div>

        <div class="flex justify-end gap-2 pt-3 border-t mt-4">
          <button type="button" id="pay-cancel" class="px-4 py-2 text-gray-400 font-bold text-[9px] uppercase">Cancelar</button>
          <button type="submit" class="px-6 py-2 bg-[#2D584C] text-white rounded-lg font-black text-[9px] uppercase tracking-widest">Confirmar Pago</button>
        </div>
      </form>
    </div>
  </div>

  <!-- VALIDACIÓN DE PAGOS STRIPE -->
  <div id="validate-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4 text-left">
    <div class="bg-white rounded-3xl w-full max-w-2xl p-8 shadow-2xl max-h-screen overflow-y-auto">
      <div class="flex justify-between items-center mb-6 border-b pb-4">
        <div>
          <h3 class="text-xl font-black text-gray-900">Validar Pago Stripe</h3>
          <p class="text-[11px] text-gray-400 font-bold uppercase mt-1">Verificar y procesar pagos recibidos</p>
        </div>
        <button id="validate-close-x" class="text-gray-400 text-2xl font-bold">✕</button>
      </div>

      <!-- Formulario de búsqueda -->
      <div id="validate-form-section" class="space-y-4">
        <div>
          <label class="block text-[10px] font-black text-gray-400 uppercase mb-2">Buscar Alumno (Nombre, No. Control, Email o CURP)</label>
          <input id="validate-search-input" type="text" placeholder="Ej: juan.perez@example.com o SAQ890101HDFLRR99" class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 text-sm focus:border-purple-600 outline-none" />
        </div>

        <div>
          <label class="block text-[10px] font-black text-gray-400 uppercase mb-2">Payment Intent ID</label>
          <input id="validate-payment-intent-input" type="text" placeholder="Ej: pi_3Lq5R52eZvKYlo2C1kYzYPpp" class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 text-sm font-mono focus:border-purple-600 outline-none" />
        </div>

        <button type="button" id="validate-submit-btn" class="w-full py-3 bg-purple-600 text-white rounded-lg font-black text-[11px] uppercase tracking-widest hover:bg-purple-700 transition-all">
          Validar Pago
        </button>
      </div>

      <!-- Resultado de validación -->
      <div id="validate-result-section" class="hidden mt-6 space-y-4">
        <!-- Info del estudiante -->
        <div id="validate-student-card" class="p-4 bg-blue-50 border-2 border-blue-200 rounded-lg">
          <div class="font-black text-[10px] text-blue-600 uppercase mb-2">Información del Estudiante</div>
          <div class="space-y-1 text-[11px]">
            <div><span class="font-bold text-gray-600">Nombre:</span> <span id="validate-student-name" class="font-mono"></span></div>
            <div><span class="font-bold text-gray-600">No. Control:</span> <span id="validate-student-control" class="font-mono"></span></div>
            <div><span class="font-bold text-gray-600">Email:</span> <span id="validate-student-email" class="font-mono"></span></div>
            <div><span class="font-bold text-gray-600">CURP:</span> <span id="validate-student-curp" class="font-mono"></span></div>
          </div>
        </div>

        <!-- Info del pago -->
        <div id="validate-payment-card" class="p-4 bg-emerald-50 border-2 border-emerald-200 rounded-lg">
          <div class="font-black text-[10px] text-emerald-600 uppercase mb-2">Detalles del Pago</div>
          <div class="space-y-1 text-[11px]">
            <div><span class="font-bold text-gray-600">ID Stripe:</span> <span id="validate-payment-id" class="font-mono"></span></div>
            <div><span class="font-bold text-gray-600">Monto:</span> <span id="validate-payment-amount" class="font-mono font-bold text-red-600"></span></div>
            <div><span class="font-bold text-gray-600">Monto Recibido:</span> <span id="validate-payment-received" class="font-mono font-bold text-emerald-600"></span></div>
            <div><span class="font-bold text-gray-600">Estado:</span> <span id="validate-payment-status" class="font-mono font-bold"></span></div>
            <div><span class="font-bold text-gray-600">Payment Intent:</span> <span id="validate-payment-intent" class="font-mono break-all text-[10px]"></span></div>
          </div>
        </div>

        <!-- Resultado de reconciliación -->
        <div id="validate-reconciliation-card" class="p-4 bg-amber-50 border-2 border-amber-200 rounded-lg">
          <div class="font-black text-[10px] text-amber-600 uppercase mb-2">Resultado de Validación</div>
          <div class="space-y-2 text-[11px]">
            <div id="validate-rec-created" class="flex items-center gap-2"><span class="w-5 h-5 rounded-full flex items-center justify-center text-[9px]" id="validate-icon-created">✓</span> <span id="validate-text-created">Registro creado</span></div>
            <div id="validate-rec-reconciled" class="flex items-center gap-2"><span class="w-5 h-5 rounded-full flex items-center justify-center text-[9px]" id="validate-icon-reconciled">✓</span> <span id="validate-text-reconciled">Registro reconciliado</span></div>
            <div id="validate-rec-notified" class="flex items-center gap-2"><span class="w-5 h-5 rounded-full flex items-center justify-center text-[9px]" id="validate-icon-notified">✓</span> <span id="validate-text-notified">Estudiante notificado</span></div>
            <div id="validate-message" class="mt-3 p-2 bg-white rounded border border-amber-200 text-[10px] italic text-gray-600"></div>
          </div>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t">
          <button type="button" id="validate-new-btn" class="px-6 py-2 bg-gray-100 text-gray-700 rounded-lg font-bold text-[10px] uppercase">Nueva Validación</button>
          <button type="button" id="validate-close-btn" class="px-6 py-2 bg-purple-600 text-white rounded-lg font-bold text-[10px] uppercase">Cerrar</button>
        </div>
      </div>

      <!-- Sección de error -->
      <div id="validate-error-section" class="hidden mt-6 p-4 bg-red-50 border-2 border-red-300 rounded-lg">
        <div class="font-black text-[10px] text-red-600 uppercase mb-2">Error en la Validación</div>
        <div id="validate-error-message" class="text-[11px] text-red-700 font-bold"></div>
        <button type="button" id="validate-error-close-btn" class="mt-3 px-4 py-2 bg-red-600 text-white rounded text-[10px] font-bold">Intentar de nuevo</button>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>

  <script is:inline define:vars={{ careerMapJSON, debtsJSON, studentsJSON }}>
    window.__CAREER_MAP = JSON.parse(careerMapJSON);
    window.__DEBTS_DATA = JSON.parse(debtsJSON);
    window.__STUDENTS_DATA = JSON.parse(studentsJSON);
    window.__API_DEBTS = 'https://nginx-production-728f.up.railway.app/api/debts';
    window.__API_PAYMENTS = 'https://nginx-production-728f.up.railway.app/api/payments';
  </script>

  <script type="module">
    import { StudentAPI } from '/studentAPI.js';
    const ITEMS_PER_PAGE = 50;
    let currentPage = 1;
    let pendingPayments = [];
    let isLoading = false;

    // Cargar datos de la API o fallback a localStorage
    const getCharges = () => pendingPayments.length > 0 ? pendingPayments : JSON.parse(localStorage.getItem('chargesList') || '[]');
    const getStudents = () => window.__STUDENTS_DATA.length > 0 ? window.__STUDENTS_DATA : JSON.parse(localStorage.getItem('studentsList') || '[]');
    const getConcepts = () => JSON.parse(localStorage.getItem('conceptsList') || '[]');
    const saveCharges = (data) => localStorage.setItem('chargesList', JSON.stringify(data));
    const fmt = n => '$' + Number(n).toLocaleString('es-MX', { minimumFractionDigits: 2 });

    const tableBody = document.getElementById('payments-table-body');
    const searchInput = document.getElementById('search-input');
    const paginationInfo = document.getElementById('pagination-info');
    const paginationButtons = document.getElementById('pagination-buttons');
    const refreshBtn = document.getElementById('refresh-debts-btn');

    // Cargar pagos pendientes desde la API
    async function loadPendingPayments(forceRefresh = false) {
      if (isLoading) return;
      
      try {
        isLoading = true;
        if (refreshBtn) {
          refreshBtn.disabled = true;
          refreshBtn.innerHTML = `
            <svg class="animate-spin w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Cargando...
          `;
        }

        const token = localStorage.getItem('access_token');
        if (!token) {
          console.warn('⚠️ No hay token de autenticación');
          renderTable();
          return;
        }

        try {
          // Intentar usar el nuevo endpoint GET /api/v1/debts
          const response = await StudentAPI.getAllPendingDebts(token, {
            search: searchInput.value.trim(),
            page: 1,
            perPage: 1000,
            forceRefresh: forceRefresh
          });
          
          if (response.success && response.data?.pending_payments?.items) {
            pendingPayments = response.data.pending_payments.items.map(payment => ({
              id: payment.id || `debt-${Date.now()}`,
              userName: payment.user_name,
              concept: payment.concept_name,
              conceptTitle: payment.concept_name,
              amount: payment.amount,
              status: 'pending'
            }));
            
            console.log('✅ Pagos pendientes cargados (GET /api/v1/debts):', pendingPayments.length);
            renderTable();
            return;
          }
        } catch (error) {
          console.warn('⚠️ No se pudo cargar con GET /api/v1/debts, usando fallback:', error.message);
        }

        // Fallback: Si el endpoint nuevo no existe, usar getPendingPayments antiguo
        const userRole = localStorage.getItem('user_role') || 'student';
        const response = await StudentAPI.getPendingPayments(null, token, forceRefresh, userRole);
        
        if (response.success && response.data?.pending_payments) {
          pendingPayments = response.data.pending_payments.map(payment => ({
            id: payment.id,
            studentId: payment.student_id || payment.studentId,
            conceptId: payment.concept_id || payment.conceptId,
            userName: payment.student_name || 'N/A',
            concept: payment.concept_name,
            conceptTitle: payment.concept_name,
            amount: payment.amount,
            status: 'pending'
          }));
          
          console.log('✅ Pagos pendientes cargados (GET /api/v1/pending-payments):', pendingPayments.length);
          renderTable();
        }
      } catch (error) {
        console.error('❌ Error al cargar pagos pendientes:', error);
        renderTable();
      } finally {
        isLoading = false;
        if (refreshBtn) {
          refreshBtn.disabled = false;
          refreshBtn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
            </svg>
            Actualizar
          `;
        }
      }
    }

    function renderTable() {
        const term = searchInput.value.toLowerCase();
        const allPending = getCharges().filter(c => !['paid', 'pagado'].includes(String(c.status).toLowerCase()));
        
        // Filtrar localmente por nombre de estudiante o concepto
        const filtered = allPending.filter(ch => {
            const fullName = (ch.userName || '').toLowerCase();
            const concept = (ch.concept || '').toLowerCase();
            return !term || fullName.includes(term) || concept.includes(term);
        });

        const totalItems = filtered.length;
        const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);
        if (currentPage > totalPages) currentPage = totalPages || 1;
        
        const start = (currentPage - 1) * ITEMS_PER_PAGE;
        const pageData = filtered.slice(start, start + ITEMS_PER_PAGE);

        tableBody.innerHTML = pageData.map((ch) => {
            return `
              <tr class="hover:bg-gray-50 transition-all border-l-4 border-transparent hover:border-[#2D584C]">
                <td class="px-8 py-5">
                    <div class="text-[12px] font-black text-gray-900 uppercase">${ch.userName || 'N/A'}</div>
                </td>
                <td class="px-8 py-5 text-[11px] text-gray-500 font-bold uppercase">${ch.concept || 'CARGO'}</td>
                <td class="px-8 py-5 text-right text-sm font-black text-red-600 font-mono">${fmt(ch.amount)}</td>
              </tr>
            `;
        }).join('');

        updatePaginationControls(totalItems, totalPages);
    }

    function updatePaginationControls(totalItems, totalPages) {
        const startItem = totalItems === 0 ? 0 : (currentPage - 1) * ITEMS_PER_PAGE + 1;
        const endItem = Math.min(currentPage * ITEMS_PER_PAGE, totalItems);
        paginationInfo.innerText = `Mostrando ${startItem}-${endItem} de ${totalItems} registros`;
        paginationButtons.innerHTML = '';
        if (totalPages <= 1) return;
        
        const createBtn = (text, targetPage, active = false, disabled = false) => {
            const btn = document.createElement('button');
            btn.innerText = text;
            btn.className = `min-w-[32px] h-8 px-2 rounded-lg text-xs font-black ${active ? 'bg-[#2D584C] text-white' : disabled ? 'text-gray-300' : 'text-gray-500 hover:bg-gray-200'}`;
            if (!disabled) btn.onclick = () => { currentPage = targetPage; renderTable(); window.scrollTo(0,0); };
            return btn;
        };
        paginationButtons.appendChild(createBtn('←', currentPage - 1, false, currentPage === 1));
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
                paginationButtons.appendChild(createBtn(i, i, currentPage === i));
            }
        }
        paginationButtons.appendChild(createBtn('→', currentPage + 1, false, currentPage === totalPages));
    }

    // --- LÓGICA DE EXPORTACIÓN EXCEL ---
    document.getElementById('export-xlsx').onclick = () => {
        const charges = getCharges().filter(c => !['paid', 'pagado'].includes(String(c.status).toLowerCase()));

        const data = charges.map((ch, idx) => {
            return {
                'No.': idx + 1,
                'Estudiante': ch.userName || 'N/A',
                'Concepto': ch.concept || 'CARGO',
                'Monto': ch.amount,
                'Estado': 'PENDIENTE'
            };
        });

        const worksheet = XLSX.utils.json_to_sheet(data);
        const workbook = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(workbook, worksheet, "Adeudos");
        XLSX.writeFile(workbook, `Adeudos_CBTA71_${new Date().toLocaleDateString()}.xlsx`);
    };

    // --- LÓGICA DEL MODAL Y AUTOCOMPLETADO ---
    const modal = document.getElementById('pay-modal');
    const paySearchInput = document.getElementById('pay-student-search');
    const autocompleteList = document.getElementById('autocomplete-list');
    const selectedInfo = document.getElementById('selected-student-info');
    const chargeSelect = document.getElementById('pay-charge-id');

    document.getElementById('open-pay-modal-btn').onclick = () => {
        document.getElementById('pay-form').reset();
        selectedInfo.classList.add('hidden');
        chargeSelect.disabled = true;
        modal.classList.replace('hidden', 'flex');
    };
    
    const closeModal = () => modal.classList.replace('flex', 'hidden');
    document.getElementById('pay-close-x').onclick = closeModal;
    document.getElementById('pay-cancel').onclick = closeModal;

    paySearchInput.addEventListener('input', () => {
        const val = paySearchInput.value.toLowerCase();
        autocompleteList.innerHTML = '';
        if (!val) return autocompleteList.classList.add('hidden');

        const students = getStudents();
        const filtered = students.filter(s => {
            const full = `${s.nombre} ${s.apellidoP} ${s.apellidoM}`.toLowerCase();
            return full.includes(val) || String(s.numControl).includes(val);
        }).slice(0, 5);

        if (filtered.length > 0) {
            filtered.forEach(s => {
                const item = document.createElement('div');
                item.className = 'px-4 py-3 hover:bg-gray-50 cursor-pointer border-b last:border-0';
                item.innerHTML = `<div class="text-[10px] font-bold">${s.nombre} ${s.apellidoP}</div><div class="text-[9px] text-gray-400">${s.numControl}</div>`;
                item.onclick = () => selectStudent(s);
                autocompleteList.appendChild(item);
            });
            autocompleteList.classList.remove('hidden');
        } else {
            autocompleteList.classList.add('hidden');
        }
    });

    function selectStudent(student) {
        paySearchInput.value = '';
        autocompleteList.classList.add('hidden');
        selectedInfo.classList.remove('hidden');
        document.getElementById('display-student-name').innerText = `${student.nombre} ${student.apellidoP} ${student.apellidoM}`;
        document.getElementById('display-student-control').innerText = `No. Control: ${student.numControl}`;
        
        const allCharges = getCharges();
        const concepts = getConcepts();
        const studentCharges = allCharges.filter(c => 
            (String(c.studentId) === String(student.id) || String(c.studentId) === String(student.numControl)) &&
            !['paid', 'pagado'].includes(String(c.status).toLowerCase())
        );

        chargeSelect.innerHTML = '<option value="">Seleccione un adeudo...</option>';
        if (studentCharges.length > 0) {
            studentCharges.forEach(ch => {
                const c = concepts.find(con => String(con.id) === String(ch.conceptId));
                const name = c ? (c.title || c.concept) : (ch.conceptTitle || ch.concept);
                const opt = document.createElement('option');
                opt.value = ch.id;
                opt.innerText = `${name} - ${fmt(ch.amount)}`;
                chargeSelect.appendChild(opt);
            });
            chargeSelect.disabled = false;
        } else {
            chargeSelect.innerHTML = '<option>Sin adeudos pendientes</option>';
            chargeSelect.disabled = true;
        }
    }

    document.getElementById('pay-form').onsubmit = (e) => {
        e.preventDefault();
        const chargeId = chargeSelect.value;
        const ref = document.getElementById('pay-code').value;
        const method = document.getElementById('pay-method').value;

        let charges = getCharges();
        const idx = charges.findIndex(c => String(c.id) === String(chargeId));

        if (idx !== -1) {
            charges[idx].status = 'paid';
            charges[idx].paymentDate = new Date().toISOString();
            charges[idx].reference = ref;
            charges[idx].method = method;
            saveCharges(charges);
            closeModal();
            renderTable();
        }
    };

    searchInput.addEventListener('input', () => { currentPage = 1; renderTable(); });
    
    // Event listener para el botón de actualizar
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => loadPendingPayments(true));
    }

    // ============================================
    // VALIDACIÓN DE PAGOS STRIPE
    // ============================================
    const validateModal = document.getElementById('validate-modal');
    const validateSearchInput = document.getElementById('validate-search-input');
    const validatePaymentIntentInput = document.getElementById('validate-payment-intent-input');
    const validateSubmitBtn = document.getElementById('validate-submit-btn');
    const validateFormSection = document.getElementById('validate-form-section');
    const validateResultSection = document.getElementById('validate-result-section');
    const validateErrorSection = document.getElementById('validate-error-section');

    // Abrir modal de validación
    document.getElementById('open-validate-modal-btn').onclick = () => {
      validateModal.classList.replace('hidden', 'flex');
      validateSearchInput.value = '';
      validatePaymentIntentInput.value = '';
      validateFormSection.classList.remove('hidden');
      validateResultSection.classList.add('hidden');
      validateErrorSection.classList.add('hidden');
    };

    // Cerrar modal de validación
    const closeValidateModal = () => {
      validateModal.classList.replace('flex', 'hidden');
    };
    document.getElementById('validate-close-x').onclick = closeValidateModal;
    document.getElementById('validate-close-btn').onclick = closeValidateModal;

    // Botón de nueva validación
    document.getElementById('validate-new-btn').onclick = () => {
      validateSearchInput.value = '';
      validatePaymentIntentInput.value = '';
      validateFormSection.classList.remove('hidden');
      validateResultSection.classList.add('hidden');
      validateErrorSection.classList.add('hidden');
      validateSearchInput.focus();
    };

    // Botón cerrar error
    document.getElementById('validate-error-close-btn').onclick = () => {
      validateFormSection.classList.remove('hidden');
      validateErrorSection.classList.add('hidden');
      validateSearchInput.focus();
    };

    // Función para formatear moneda
    const formatCurrency = (amount) => {
      const num = parseFloat(amount);
      return '$' + num.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };

    // Función para mostrar estado con color
    const getStatusBadge = (status) => {
      const statusMap = {
        'succeeded': { bg: 'bg-emerald-100', text: 'text-emerald-700', label: 'Exitoso' },
        'pending': { bg: 'bg-amber-100', text: 'text-amber-700', label: 'Pendiente' },
        'failed': { bg: 'bg-red-100', text: 'text-red-700', label: 'Fallido' }
      };
      const config = statusMap[status] || { bg: 'bg-gray-100', text: 'text-gray-700', label: status };
      return `<span class="px-2 py-1 rounded text-[9px] font-bold ${config.bg} ${config.text}">${config.label}</span>`;
    };

    // Validar pago
    validateSubmitBtn.onclick = async () => {
      const search = validateSearchInput.value.trim();
      const paymentIntentId = validatePaymentIntentInput.value.trim();

      // Validación de campos
      if (!search) {
        showValidationError('Por favor ingresa un término de búsqueda (email, No. Control, CURP, nombre)');
        return;
      }

      if (!paymentIntentId) {
        showValidationError('Por favor ingresa el Payment Intent ID');
        return;
      }

      try {
        validateSubmitBtn.disabled = true;
        validateSubmitBtn.textContent = 'Validando...';
        validateSubmitBtn.classList.add('opacity-50');

        const token = localStorage.getItem('access_token');
        if (!token) {
          showValidationError('No hay sesión activa. Por favor inicia sesión.');
          return;
        }

        const response = await StudentAPI.validateStripePayment(search, paymentIntentId, token);

        if (!response.success) {
          showValidationError(response.message || 'Error al validar el pago');
          return;
        }

        // Mostrar resultados
        displayPaymentValidation(response.data);

      } catch (error) {
        console.error('❌ Error en validación:', error);
        showValidationError(error.message || 'Error al procesar la validación');
      } finally {
        validateSubmitBtn.disabled = false;
        validateSubmitBtn.textContent = 'Validar Pago';
        validateSubmitBtn.classList.remove('opacity-50');
      }
    };

    function displayPaymentValidation(data) {
      // Información del estudiante
      const student = data.student || {};
      document.getElementById('validate-student-name').textContent = student.fullName || 'N/A';
      document.getElementById('validate-student-control').textContent = student.n_control || 'N/A';
      document.getElementById('validate-student-email').textContent = student.email || 'N/A';
      document.getElementById('validate-student-curp').textContent = student.curp || 'N/A';

      // Información del pago
      const payment = data.payment || {};
      document.getElementById('validate-payment-id').textContent = payment.id || 'N/A';
      document.getElementById('validate-payment-amount').textContent = formatCurrency(payment.amount || 0);
      document.getElementById('validate-payment-received').textContent = formatCurrency(payment.amount_received || 0);
      document.getElementById('validate-payment-status').innerHTML = getStatusBadge(payment.status || 'unknown');
      document.getElementById('validate-payment-intent').textContent = payment.payment_intent_id || 'N/A';

      // Resultado de reconciliación
      const metadata = data.metadata || {};
      const reconciliation = data.reconciliation || {};

      // Iconos con colores
      const setReconciliationItem = (id, success, text, icon) => {
        const elem = document.getElementById(id);
        const iconElem = document.getElementById(id.replace('rec-', 'icon-'));
        const textElem = document.getElementById(id.replace('rec-', 'text-'));
        
        if (success) {
          iconElem.classList.remove('bg-gray-200', 'text-gray-400');
          iconElem.classList.add('bg-emerald-200', 'text-emerald-700');
          iconElem.textContent = '✓';
        } else {
          iconElem.classList.remove('bg-emerald-200', 'text-emerald-700');
          iconElem.classList.add('bg-red-200', 'text-red-700');
          iconElem.textContent = '✕';
        }
        textElem.textContent = text;
        elem.className = `flex items-center gap-2 ${success ? 'text-emerald-700' : 'text-red-700'}`;
      };

      setReconciliationItem(
        'validate-rec-created',
        metadata.wasCreated,
        metadata.wasCreated ? 'Registro creado correctamente' : 'Registro no fue creado'
      );

      setReconciliationItem(
        'validate-rec-reconciled',
        metadata.wasReconciled,
        metadata.wasReconciled ? 'Pago reconciliado' : 'Pago no fue reconciliado'
      );

      setReconciliationItem(
        'validate-rec-notified',
        reconciliation.notified > 0,
        reconciliation.notified > 0 ? `${reconciliation.notified} estudiante(s) notificado(s)` : 'Sin notificaciones enviadas'
      );

      const message = metadata.message || '';
      if (message) {
        document.getElementById('validate-message').textContent = message;
        document.getElementById('validate-message').classList.remove('hidden');
      } else {
        document.getElementById('validate-message').classList.add('hidden');
      }

      // Mostrar resultado, ocultar formulario
      validateFormSection.classList.add('hidden');
      validateResultSection.classList.remove('hidden');
      validateErrorSection.classList.add('hidden');
    }

    function showValidationError(message) {
      validateFormSection.classList.add('hidden');
      validateResultSection.classList.add('hidden');
      validateErrorSection.classList.remove('hidden');
      document.getElementById('validate-error-message').textContent = message;
    }
    
    // Cargar datos inicialmente
    loadPendingPayments();
  </script>
</Layout>