---
// src/pages/pago_estado.astro
import Layout from "../layouts/Layout.astro"; 
import { API_ENDPOINTS } from "../config/api.js";

const pageTitle = "Historial de Pagos - CBTA 71";

// Configuración de Carreras para el mapeo de nombres en Excel
const CAREER_MAP = {
  'TAG-E': 'Técnico Agropecuario',
  'TOF': 'Técnico en Ofimática',
  'TEM': 'Técnico en Admón. de Emprendimiento',
  'TAG-M': 'Técnico Agropecuario (Mixta)',
  'TRH': 'Técnico en Admón. de Recursos Humanos (Mixta)',
  '': 'Sin Carrera'
};

let students = [];
try {
    const res = await fetch(API_ENDPOINTS.students.list);
    if (res.ok) {
        const json = await res.json();
        students = Array.isArray(json) ? json : (Array.isArray(json.data) ? json.data : []);
    }
} catch (e) {}

if (!students.length) {
    // Fallback data removed - API should provide students
    students = [];
}

const safeStudents = students.map((s, i) => ({
    id: s.id ?? String(i + 1),
    numControl: s.numControl ?? s.id ?? '',
    nombre: s.nombre ?? s.name ?? '',
    apellidoP: s.apellidoP ?? s.apellidoPaterno ?? '',
    apellidoM: s.apellidoM ?? s.apellidoMaterno ?? '',
    semestre: s.semestre ?? '1',
    carrera: s.carrera ?? '',
}));

const studentsJSON = JSON.stringify(safeStudents).replace(/</g, '\\u003c');
const careerMapJSON = JSON.stringify(CAREER_MAP);
---

<Layout title={pageTitle}>
<style is:global>
    :root { --cbta-green: #2E594D; }
    
    .page-link {
        width: 2.5rem; height: 2.5rem;
        display: flex; align-items: center; justify-content: center;
        border-radius: 0.75rem; border: 1px solid #f3f4f6;
        color: #9ca3af; transition: all 0.2s;
        background: white; cursor: pointer; font-weight: 700;
    }
    .page-link.active {
        background-color: #2E594D; color: white; border-color: #2E594D;
    }

    .filter-card {
        position: absolute; top: 100%; right: 0; margin-top: 0.5rem;
        width: 18rem; background: white; border-radius: 1rem;
        box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1);
        border: 1px solid #f3f4f6; padding: 1.25rem;
        z-index: 50; display: none;
    }
    .filter-card.show { display: block; }
</style>

<div class="max-w-7xl mx-auto px-6 py-10 bg-gradient-to-br from-gray-50 via-white to-[#2E594D]/5 min-h-screen">

    <header class="flex items-center gap-5 mb-10 pb-6 bg-white rounded-2xl shadow-lg px-6 py-5">
        <div class="p-4 bg-gradient-to-br from-[#2D584C] to-[#1e3d35] rounded-2xl shadow-xl shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
        </div>
        <div>
            <h1 class="text-3xl font-black text-[#2D584C] tracking-tight leading-none flex items-center gap-3">
                Historial de Pagos Realizados
                <span class="text-xs bg-[#2D584C]/10 text-[#2D584C] px-3 py-1 rounded-full font-semibold">Auditoría</span>
            </h1>
            <p class="text-sm text-gray-600 mt-2 font-medium flex items-center gap-2">
                <i class="fas fa-chart-line text-[#2D584C]"></i>
                Panel de control y auditoría financiera
            </p>
        </div>
    </header>

    <div class="flex flex-row items-center gap-3 mb-8 w-full">
        <div class="relative flex-grow">
            <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
            <input type="text" id="search-input" placeholder="Buscar por nombre, matrícula o concepto..." class="w-full pl-12 pr-4 h-[48px] bg-white border-2 border-gray-200 rounded-xl text-sm text-gray-700 focus:ring-4 focus:ring-[#2E594D]/10 focus:border-[#2E594D] outline-none transition-all shadow-md" />
        </div>

        <div class="flex items-center gap-2 relative">
            <button id="toggle-filters" class="flex items-center gap-2 px-5 h-[48px] border-2 border-[#2E594D] text-[#2E594D] font-bold text-sm rounded-xl hover:bg-[#2E594D] hover:text-white hover:scale-105 hover:shadow-xl transition-all shadow-md">
                <i class="fas fa-filter"></i>
                <span>Filtros</span>
            </button>

            <div id="filter-menu" class="filter-card">
                <h3 class="font-bold text-slate-800 mb-4 border-b pb-2">Opciones de Filtrado</h3>
                <div class="space-y-4">
                    <div>
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Semestre:</label>
                        <select id="semester-filter" class="w-full mt-1 p-2 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-[#2E594D]">
                            <option value="all">Todos</option>
                            {[...Array(10)].map((_, i) => ( <option value={i + 1}>{i + 1}º Semestre</option> ))}
                        </select>
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Método:</label>
                        <select id="method-filter" class="w-full mt-1 p-2 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-[#2E594D]">
                            <option value="all">Todos</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Transferencia">Transferencia</option>
                            <option value="Depósito">Depósito</option>
                        </select>
                    </div>
                    <button id="clear-filters" class="w-full mt-2 p-2 bg-red-50 text-red-500 rounded-lg text-sm font-bold hover:bg-red-100 transition-colors">Limpiar Filtros</button>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-gradient-to-br from-white via-[#2D584C]/5 to-white rounded-2xl shadow-2xl border-2 border-[#2D584C]/20 overflow-hidden mb-8">
        <div class="overflow-x-auto">
            <table class="w-full border-collapse">
                <thead class="bg-gradient-to-r from-[#2D584C] to-[#1e3d35]">
                    <tr>
                        <th class="px-8 py-5 text-left text-xs font-black uppercase tracking-wider text-white">
                            <div class="flex items-center gap-2">
                                <i class="fas fa-calendar-alt"></i>
                                <span>Fecha</span>
                            </div>
                        </th>
                        <th class="px-8 py-5 text-left text-xs font-black uppercase tracking-wider text-white">
                            <div class="flex items-center gap-2">
                                <i class="fas fa-file-invoice-dollar"></i>
                                <span>Concepto de Pago</span>
                            </div>
                        </th>
                        <th class="px-8 py-5 text-left text-xs font-black uppercase tracking-wider text-white">
                            <div class="flex items-center gap-2">
                                <i class="fas fa-user-graduate"></i>
                                <span>Estudiante</span>
                            </div>
                        </th>
                        <th class="px-8 py-5 text-left text-xs font-black uppercase tracking-wider text-white">
                            <div class="flex items-center gap-2">
                                <i class="fas fa-credit-card"></i>
                                <span>Método</span>
                            </div>
                        </th>
                        <th class="px-8 py-5 text-right text-xs font-black uppercase tracking-wider text-white">
                            <div class="flex items-center justify-end gap-2">
                                <i class="fas fa-dollar-sign"></i>
                                <span>Monto</span>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody id="payments-table-body" class="bg-white divide-y divide-gray-100"></tbody>
            </table>
        </div>
    </div>

    <div class="flex flex-col items-center gap-4 py-6 bg-white rounded-xl shadow-md">
        <p class="text-xs font-bold text-[#2D584C] flex items-center gap-2">
            <i class="fas fa-list"></i>
            <span>Total de Registros: <span id="p-total" class="text-base">0</span></span>
        </p>
        <div class="flex items-center gap-2" id="pagination-controls"></div>
    </div>
</div>

<script is:inline define:vars={{ studentsJSON, careerMapJSON }}>
window.__INITIAL_STUDENTS_PAYMENTS = JSON.parse(studentsJSON);
window.__CAREER_MAP = JSON.parse(careerMapJSON);
</script>

<script type="module">
import { StudentAPI } from '../utils/studentAPI.js';

(function() {
    let currentPage = 1;
    const itemsPerPage = 50;
    let filteredData = [];
    let isLoading = false;

    const tableBody = document.getElementById('payments-table-body');
    const searchInput = document.getElementById('search-input');
    const filterMenu = document.getElementById('filter-menu');

    document.getElementById('toggle-filters').onclick = (e) => { e.stopPropagation(); filterMenu.classList.toggle('show'); };
    document.onclick = () => filterMenu.classList.remove('show');
    filterMenu.onclick = (e) => e.stopPropagation();

    // Cargar pagos desde API
    async function loadPayments() {
        if (isLoading) return;
        isLoading = true;

        try {
            const token = localStorage.getItem('access_token');
            if (!token) {
                console.warn('⚠️ No hay token de autenticación');
                render();
                return;
            }

            try {
                // Intentar usar el nuevo endpoint GET /api/v1/payments
                const response = await StudentAPI.getAllPayments(token, {
                    search: searchInput.value.trim(),
                    page: 1,
                    perPage: 1000, // Obtener muchos para paginación local
                    forceRefresh: false
                });

                if (response.success && response.data?.payments?.items) {
                    const allPayments = response.data.payments.items.map(payment => ({
                        id: payment.id,
                        date: payment.date,
                        concept: payment.concept,
                        amount: payment.amount,
                        amount_received: payment.amount_received,
                        method: payment.method,
                        fullName: payment.fullName,
                        paidAt: payment.date
                    }));

                    localStorage.setItem('paymentsList', JSON.stringify(allPayments));
                    console.log('✅ Pagos cargados (GET /api/v1/payments):', allPayments.length);
                    render();
                    return;
                }
            } catch (error) {
                console.warn('⚠️ No se pudo cargar con GET /api/v1/payments:', error.message);
            }

            // Fallback: Usar datos de localStorage si el endpoint falla
            render();
        } finally {
            isLoading = false;
        }
    }

    const render = () => {
        const allPayments = JSON.parse(localStorage.getItem('paymentsList') || '[]') || [];
        const students = JSON.parse(localStorage.getItem('studentsList') || '[]') || window.__INITIAL_STUDENTS_PAYMENTS;

        const term = searchInput.value.toLowerCase();
        const semesterSel = document.getElementById('semester-filter').value;
        const methodSel = document.getElementById('method-filter').value;

        filteredData = allPayments.filter(p => {
            const matchesSearch = 
                (p.fullName || '').toLowerCase().includes(term) || 
                (p.concept || '').toLowerCase().includes(term);
            
            const matchesMethod = methodSel === 'all' || (p.method || '').includes(methodSel);
            
            return matchesSearch && matchesMethod;
        });

        const startIdx = (currentPage - 1) * itemsPerPage;
        const pageItems = filteredData.slice(startIdx, startIdx + itemsPerPage);

        tableBody.innerHTML = pageItems.map(p => {
            const dateStr = p.date || p.paidAt || new Date().toISOString();
            const displayDate = new Date(dateStr).toLocaleDateString('es-MX');

            return `
                <tr class="hover:bg-gradient-to-r hover:from-[#2D584C]/5 hover:to-transparent transition-all duration-200">
                    <td class="px-8 py-5 text-gray-600 font-semibold text-xs">
                        <div class="flex items-center gap-2">
                            <i class="far fa-calendar text-[#2D584C]"></i>
                            <span>${displayDate}</span>
                        </div>
                    </td>
                    <td class="px-8 py-5">
                        <span class="text-gray-900 font-extrabold text-xs uppercase block tracking-tight">
                            ${p.concept || 'PAGO REGISTRADO'}
                        </span>
                    </td>
                    <td class="px-8 py-5">
                        <div class="flex items-center gap-2">
                            <i class="fas fa-user text-[#2D584C] text-xs"></i>
                            <span class="text-gray-800 font-bold text-xs uppercase">${p.fullName || 'N/A'}</span>
                        </div>
                    </td>
                    <td class="px-8 py-5">
                        <span class="inline-flex items-center gap-1 text-[10px] font-bold text-white uppercase bg-gradient-to-r from-blue-600 to-blue-700 px-3 py-1 rounded-full">
                            <i class="fas fa-money-bill-wave text-xs"></i>
                            ${p.method || 'N/A'}
                        </span>
                    </td>
                    <td class="px-8 py-5 text-right">
                        <span class="font-black text-[#2E594D] text-base">
                            $${Number(p.amount || 0).toLocaleString('es-MX', {minimumFractionDigits:2})}
                        </span>
                    </td>
                </tr>
            `;
        }).join('');

        document.getElementById('p-total').textContent = filteredData.length;
        renderPagination(Math.ceil(filteredData.length / itemsPerPage));
    };

    const renderPagination = (totalPages) => {
        const controls = document.getElementById('pagination-controls');
        if(totalPages <= 1) { controls.innerHTML = ''; return; }
        let html = '';
        for(let i=1; i<=totalPages; i++) {
            html += `<button class="page-link ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
        }
        controls.innerHTML = html;
        controls.querySelectorAll('button').forEach(b => {
            b.onclick = () => { currentPage = parseInt(b.dataset.page); render(); };
        });
    };

    searchInput.oninput = () => { currentPage = 1; render(); };
    document.getElementById('semester-filter').onchange = () => { currentPage = 1; render(); };
    document.getElementById('method-filter').onchange = () => { currentPage = 1; render(); };
    document.getElementById('clear-filters').onclick = () => { 
        searchInput.value = ''; 
        document.getElementById('semester-filter').value = 'all'; 
        document.getElementById('method-filter').value = 'all'; 
        render(); 
    };

    // Cargar pagos al iniciar
    loadPayments();
})();
</script>
</Layout>