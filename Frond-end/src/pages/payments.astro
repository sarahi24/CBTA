---
import Layout from "../layouts/Layout.astro"; 

const pageTitle = "Gestión de Pagos - CBTA 71";
---

<Layout title={pageTitle}>
<style is:global>
    :root { --cbta-green: #2E594D; }
    
    .page-link {
        width: 2.5rem; height: 2.5rem;
        display: flex; align-items: center; justify-content: center;
        border-radius: 0.75rem; border: 1px solid #f3f4f6;
        color: #9ca3af; transition: all 0.2s;
        background: white; cursor: pointer; font-weight: 700;
    }
    .page-link.active {
        background-color: #2E594D; color: white; border-color: #2E594D;
    }

    .filter-card {
        position: absolute; top: 100%; right: 0; margin-top: 0.5rem;
        width: 18rem; background: white; border-radius: 1rem;
        box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1);
        border: 1px solid #f3f4f6; padding: 1.25rem;
        z-index: 50; display: none;
    }
    .filter-card.show { display: block; }
</style>

<div class="max-w-7xl mx-auto px-6 py-10 bg-gradient-to-br from-gray-50 via-white to-[#2E594D]/5 min-h-screen">

    <header class="flex items-center gap-5 mb-10 pb-6 bg-white rounded-2xl shadow-lg px-6 py-5">
        <div class="p-4 bg-gradient-to-br from-[#2D584C] to-[#1e3d35] rounded-2xl shadow-xl shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
        </div>
        <div>
            <h1 class="text-3xl font-black text-[#2D584C] tracking-tight leading-none flex items-center gap-3">
                Historial de Pagos Realizados
                <span class="text-xs bg-[#2D584C]/10 text-[#2D584C] px-3 py-1 rounded-full font-semibold">Auditoría</span>
            </h1>
            <p class="text-sm text-gray-600 mt-2 font-medium flex items-center gap-2">
                <i class="fas fa-chart-line text-[#2D584C]"></i>
                Panel de control y auditoría financiera
            </p>
        </div>
    </header>

    <div class="flex flex-row items-center gap-3 mb-8 w-full">
        <div class="relative flex-grow">
            <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
            <input type="text" id="search-input" placeholder="Buscar por email, nombre o concepto..." class="w-full pl-12 pr-4 h-[48px] bg-white border-2 border-gray-200 rounded-xl text-sm text-gray-700 focus:ring-4 focus:ring-[#2E594D]/10 focus:border-[#2E594D] outline-none transition-all shadow-md" />
        </div>

        <div class="flex items-center gap-2 relative">
            <button id="refresh-btn" class="flex items-center gap-2 px-5 h-[48px] border-2 border-green-600 text-green-600 font-bold text-sm rounded-xl hover:bg-green-600 hover:text-white hover:scale-105 hover:shadow-xl transition-all shadow-md" title="Actualizar caché">
                <i class="fas fa-sync-alt"></i>
                <span>Actualizar</span>
            </button>
            <button id="toggle-filters" class="flex items-center gap-2 px-5 h-[48px] border-2 border-[#2E594D] text-[#2E594D] font-bold text-sm rounded-xl hover:bg-[#2E594D] hover:text-white hover:scale-105 hover:shadow-xl transition-all shadow-md">
                <i class="fas fa-filter"></i>
                <span>Filtros</span>
            </button>

            <div id="filter-menu" class="filter-card">
                <h3 class="font-bold text-slate-800 mb-4 border-b pb-2">Opciones de Filtrado</h3>
                <div class="space-y-4">
                    <div>
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Semestre:</label>
                        <select id="semester-filter" class="w-full mt-1 p-2 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-[#2E594D]">
                            <option value="all">Todos</option>
                            {[...Array(10)].map((_, i) => ( <option value={i + 1}>{i + 1}º Semestre</option> ))}
                        </select>
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Método:</label>
                        <select id="method-filter" class="w-full mt-1 p-2 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-[#2E594D]">
                            <option value="all">Todos</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Transferencia">Transferencia</option>
                            <option value="Depósito">Depósito</option>
                        </select>
                    </div>
                    <button id="clear-filters" class="w-full mt-2 p-2 bg-red-50 text-red-500 rounded-lg text-sm font-bold hover:bg-red-100 transition-colors">Limpiar Filtros</button>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-gradient-to-br from-white via-[#2D584C]/5 to-white rounded-2xl shadow-2xl border-2 border-[#2D584C]/20 overflow-hidden mb-8">
        <div class="overflow-x-auto">
            <table class="w-full border-collapse">
                <thead class="bg-gradient-to-r from-[#2D584C] to-[#1e3d35]">
                    <tr>
                        <th class="px-8 py-5 text-left text-xs font-black uppercase tracking-wider text-white">
                            <div class="flex items-center gap-2">
                                <i class="fas fa-file-invoice-dollar"></i>
                                <span>Concepto</span>
                            </div>
                        </th>
                        <th class="px-8 py-5 text-right text-xs font-black uppercase tracking-wider text-white">
                            <div class="flex items-center justify-end gap-2">
                                <i class="fas fa-coins"></i>
                                <span>Total</span>
                            </div>
                        </th>
                        <th class="px-8 py-5 text-right text-xs font-black uppercase tracking-wider text-white">
                            <div class="flex items-center justify-end gap-2">
                                <i class="fas fa-hand-holding-dollar"></i>
                                <span>Recaudado</span>
                            </div>
                        </th>
                        <th class="px-8 py-5 text-right text-xs font-black uppercase tracking-wider text-white">
                            <div class="flex items-center justify-end gap-2">
                                <i class="fas fa-percentage"></i>
                                <span>Tasa Cobranza</span>
                            </div>
                        </th>
                        <th class="px-8 py-5 text-left text-xs font-black uppercase tracking-wider text-white">
                            <div class="flex items-center gap-2">
                                <i class="fas fa-calendar-check"></i>
                                <span>Período de Pagos</span>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody id="payments-table-body" class="bg-white divide-y divide-gray-100"></tbody>
            </table>
        </div>
    </div>

    <div class="flex flex-col items-center gap-4 py-6 bg-white rounded-xl shadow-md">
        <div class="flex items-center gap-6">
            <p class="text-xs font-bold text-[#2D584C] flex items-center gap-2">
                <i class="fas fa-list"></i>
                <span>Total de Registros: <span id="p-total" class="text-base">0</span></span>
            </p>
            <p class="text-xs font-bold text-gray-500 flex items-center gap-2">
                <i class="fas fa-file-alt"></i>
                <span>Página <span id="current-page" class="text-base text-[#2D584C]">1</span> de <span id="last-page" class="text-base text-[#2D584C]">1</span></span>
            </p>
        </div>
        <div class="flex items-center gap-2" id="pagination-controls"></div>
    </div>
</div>

<script type="module">
import { StudentAPI } from '/studentAPI.js';

(function() {
    let currentPage = 1;
    let lastPage = 1;
    let totalRecords = 0;
    const itemsPerPage = 15;
    let isLoading = false;
    let searchTerm = '';
    let searchTimeout = null;

    const tableBody = document.getElementById('payments-table-body');
    const searchInput = document.getElementById('search-input');
    const refreshBtn = document.getElementById('refresh-btn');
    const filterMenu = document.getElementById('filter-menu');

    // Formatear fecha
    const formatDate = (dateString) => {
        if (!dateString) return 'N/A';
        try {
            const date = new Date(dateString);
            return date.toLocaleDateString('es-MX', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
            });
        } catch {
            return dateString;
        }
    };

    // Normalizar concepto de pago
    const normalizePaymentConcept = (item) => {
        return {
            conceptName: item.concept_name || item.conceptName || 'N/A',
            amountTotal: parseFloat(item.amount_total || item.amountTotal || 0),
            amountReceivedTotal: parseFloat(item.amount_received_total || item.amountReceivedTotal || 0),
            collectionRate: parseFloat(item.collection_rate || item.collectionRate || 0),
            firstPaymentDate: item.first_payment_date || item.firstPaymentDate || null,
            lastPaymentDate: item.last_payment_date || item.lastPaymentDate || null
        };
    };

    document.getElementById('toggle-filters').onclick = (e) => { 
        e.stopPropagation(); 
        filterMenu.classList.toggle('show'); 
    };
    document.onclick = () => filterMenu.classList.remove('show');
    filterMenu.onclick = (e) => e.stopPropagation();

    // Cargar pagos por concepto desde API con paginación
    async function loadPayments(forceRefresh = false) {
        if (isLoading) return;
        isLoading = true;

        // Mostrar indicador de carga
        tableBody.innerHTML = `
            <tr>
                <td colspan="5" class="px-8 py-12 text-center">
                    <div class="flex flex-col items-center gap-3">
                        <i class="fas fa-spinner fa-spin text-4xl text-[#2D584C]"></i>
                        <p class="text-gray-600 font-bold">${forceRefresh ? 'Actualizando datos...' : 'Cargando pagos...'}</p>
                    </div>
                </td>
            </tr>
        `;

        try {
            const token = localStorage.getItem('access_token');
            if (!token) {
                showError('No hay sesión activa. Por favor inicia sesión.');
                setTimeout(() => window.location.href = '/login', 2000);
                return;
            }

            // Usar endpoint /api/v1/payments/by-concept
            const response = await StudentAPI.getPaymentsByConcept(token, {
                search: searchTerm,
                page: currentPage,
                perPage: itemsPerPage,
                forceRefresh: forceRefresh
            });

            if (response.success && response.data?.payments) {
                const paymentsData = response.data.payments;
                
                // Actualizar variables de paginación
                currentPage = paymentsData.currentPage || 1;
                lastPage = paymentsData.lastPage || 1;
                totalRecords = paymentsData.total || 0;

                console.log(`✅ Conceptos de pago cargados: ${paymentsData.items?.length || 0} de ${totalRecords} total`);
                
                renderPayments(paymentsData.items || []);
                updatePaginationInfo();
            } else {
                showError('No se pudieron cargar los pagos por concepto');
            }
        } catch (error) {
            console.error('❌ Error al cargar pagos por concepto:', error);
            showError(error.message || 'Error al cargar los pagos');
        } finally {
            isLoading = false;
        }
    }

    // Renderizar pagos por concepto en la tabla
    const renderPayments = (payments) => {
        if (!payments || payments.length === 0) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="5" class="px-8 py-12 text-center">
                        <div class="flex flex-col items-center gap-3">
                            <i class="fas fa-inbox text-5xl text-gray-300"></i>
                            <p class="text-gray-500 font-bold">No se encontraron conceptos de pago</p>
                            <p class="text-gray-400 text-sm">Intenta ajustar los filtros de búsqueda</p>
                        </div>
                    </td>
                </tr>
            `;
            return;
        }

        tableBody.innerHTML = payments.map(p => {
            const normalized = normalizePaymentConcept(p);
            
            // Determinar color de tasa de cobranza
            let collectionColor = 'text-red-600';
            if (normalized.collectionRate >= 75) collectionColor = 'text-emerald-600';
            else if (normalized.collectionRate >= 50) collectionColor = 'text-amber-600';

            // Período de pagos
            const periodStart = formatDate(normalized.firstPaymentDate);
            const periodEnd = formatDate(normalized.lastPaymentDate);
            const periodText = periodStart === 'N/A' ? 'Sin registros' : `${periodStart} - ${periodEnd}`;

            return `
                <tr class="hover:bg-gradient-to-r hover:from-[#2D584C]/5 hover:to-transparent transition-all duration-200">
                    <td class="px-8 py-5">
                        <span class="text-gray-900 font-extrabold text-sm uppercase block tracking-tight">
                            ${normalized.conceptName}
                        </span>
                    </td>
                    <td class="px-8 py-5 text-right">
                        <span class="text-gray-700 font-bold text-sm">
                            $${normalized.amountTotal.toLocaleString('es-MX', {minimumFractionDigits:2, maximumFractionDigits:2})}
                        </span>
                    </td>
                    <td class="px-8 py-5 text-right">
                        <span class="text-emerald-700 font-black text-sm">
                            $${normalized.amountReceivedTotal.toLocaleString('es-MX', {minimumFractionDigits:2, maximumFractionDigits:2})}
                        </span>
                    </td>
                    <td class="px-8 py-5 text-right">
                        <span class="font-black text-base ${collectionColor}">
                            ${normalized.collectionRate.toFixed(2)}%
                        </span>
                    </td>
                    <td class="px-8 py-5 text-left">
                        <div class="flex items-center gap-2 text-xs text-gray-600 font-semibold">
                            <i class="fas fa-calendar text-[#2D584C]"></i>
                            <span>${periodText}</span>
                        </div>
                    </td>
                </tr>
            `;
        }).join('');
    };

    // Mostrar errores
    const showError = (message) => {
        tableBody.innerHTML = `
            <tr>
                <td colspan="5" class="px-8 py-12 text-center">
                    <div class="flex flex-col items-center gap-3">
                        <i class="fas fa-exclamation-triangle text-5xl text-red-400"></i>
                        <p class="text-red-600 font-bold">${message}</p>
                        <button onclick="location.reload()" class="mt-2 px-4 py-2 bg-[#2D584C] text-white rounded-lg hover:bg-[#1e3d35] transition">
                            Reintentar
                        </button>
                    </div>
                </td>
            </tr>
        `;
    };

    // Actualizar información de paginación
    const updatePaginationInfo = () => {
        document.getElementById('p-total').textContent = totalRecords;
        document.getElementById('current-page').textContent = currentPage;
        document.getElementById('last-page').textContent = lastPage;
        renderPagination();
    };

    const renderPagination = () => {
        const controls = document.getElementById('pagination-controls');
        if(lastPage <= 1) { 
            controls.innerHTML = ''; 
            return; 
        }

        let html = '';
        
        // Botón anterior
        html += `
            <button class="page-link ${currentPage === 1 ? 'opacity-50 cursor-not-allowed' : ''}" 
                    data-page="${currentPage - 1}" 
                    ${currentPage === 1 ? 'disabled' : ''}>
                <i class="fas fa-chevron-left"></i>
            </button>
        `;

        // Páginas
        const maxVisible = 5;
        let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        let endPage = Math.min(lastPage, startPage + maxVisible - 1);
        
        if (endPage - startPage < maxVisible - 1) {
            startPage = Math.max(1, endPage - maxVisible + 1);
        }

        if (startPage > 1) {
            html += `<button class="page-link" data-page="1">1</button>`;
            if (startPage > 2) {
                html += `<span class="px-2 text-gray-400">...</span>`;
            }
        }

        for(let i = startPage; i <= endPage; i++) {
            html += `<button class="page-link ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
        }

        if (endPage < lastPage) {
            if (endPage < lastPage - 1) {
                html += `<span class="px-2 text-gray-400">...</span>`;
            }
            html += `<button class="page-link" data-page="${lastPage}">${lastPage}</button>`;
        }

        // Botón siguiente
        html += `
            <button class="page-link ${currentPage === lastPage ? 'opacity-50 cursor-not-allowed' : ''}" 
                    data-page="${currentPage + 1}" 
                    ${currentPage === lastPage ? 'disabled' : ''}>
                <i class="fas fa-chevron-right"></i>
            </button>
        `;

        controls.innerHTML = html;
        controls.querySelectorAll('button:not([disabled])').forEach(b => {
            b.onclick = () => { 
                const newPage = parseInt(b.dataset.page);
                if (newPage >= 1 && newPage <= lastPage && newPage !== currentPage) {
                    currentPage = newPage;
                    loadPayments();
                }
            };
        });
    };

    // Event listeners
    searchInput.oninput = () => { 
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            searchTerm = searchInput.value.trim();
            currentPage = 1;
            loadPayments();
        }, 500); // Debounce de 500ms
    };

    refreshBtn.onclick = () => {
        const icon = refreshBtn.querySelector('i');
        icon.classList.add('fa-spin');
        loadPayments(true).finally(() => {
            icon.classList.remove('fa-spin');
        });
    };

    document.getElementById('semester-filter').onchange = () => { 
        currentPage = 1; 
        loadPayments(); 
    };
    
    document.getElementById('method-filter').onchange = () => { 
        currentPage = 1; 
        loadPayments(); 
    };
    
    document.getElementById('clear-filters').onclick = () => { 
        searchInput.value = ''; 
        searchTerm = '';
        document.getElementById('semester-filter').value = 'all'; 
        document.getElementById('method-filter').value = 'all'; 
        currentPage = 1;
        loadPayments(); 
    };

    // Cargar pagos al iniciar
    loadPayments();
})();
</script>
</Layout>