---
// src/pages/concepts.astro
import Layout from '../layouts/Layout.astro'; 
const pageTitle = "Conceptos de Cobro"; 

const PRIMARY_ACCENT_COLOR = 'bg-[#2E584C]'; 
const PRIMARY_HOVER = 'hover:bg-[#274D43]'; 
const PRIMARY_TEXT_COLOR = 'text-[#2E584C]'; 
const API_BASE_URL = 'https://nginx-production-728f.up.railway.app/api';
---

<Layout title={pageTitle}>  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 bg-gradient-to-br from-slate-50 via-white to-emerald-50/30 min-h-screen">

    <!-- Header mejorado con animación -->
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-12 bg-white rounded-3xl shadow-2xl px-8 py-6 border border-gray-100 relative overflow-hidden">
      <!-- Decoración de fondo -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-[#2E594D]/5 to-emerald-500/5 rounded-full blur-3xl -z-0"></div>
      
      <div class="flex items-center gap-5 relative z-10">
        <div class="p-4 bg-gradient-to-br from-[#2E594D] via-emerald-700 to-[#1e3d35] rounded-2xl shadow-2xl flex-shrink-0 transform hover:rotate-6 transition-transform duration-300">
          <i class="fas fa-file-invoice-dollar text-4xl text-white"></i>
        </div>

        <div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-[#2E594D] to-emerald-700 tracking-tight flex flex-wrap items-center gap-3">
            Gestión de Conceptos
            <span class="text-[10px] bg-gradient-to-r from-emerald-500 to-teal-600 text-white px-4 py-1.5 rounded-full font-bold shadow-lg animate-pulse">ACTIVO</span>
          </h1>
          <p class="text-sm text-gray-600 mt-3 flex items-center gap-2 font-medium">
            <i class="fas fa-lightbulb text-amber-500 animate-pulse"></i>
            <span>Administra y asigna conceptos de cobro de forma inteligente</span>
          </p>
        </div>
      </div>

      <a href="/new"
         class="mt-6 sm:mt-0 px-8 py-4 bg-gradient-to-r from-[#2E594D] via-emerald-700 to-teal-700 text-white font-bold rounded-2xl shadow-xl hover:shadow-2xl hover:scale-105 hover:-translate-y-1 transition-all duration-300 text-sm sm:text-base flex items-center gap-3 relative z-10 group overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-emerald-600 to-teal-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <i class="fas fa-plus-circle text-lg relative z-10"></i> 
        <span class="relative z-10">Crear Concepto</span>
      </a>
    </header>

    <div id="concepts-grid"
         class="grid gap-8"
         style="grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));">
    </div>

  </div>

<script type="module">
const PRIMARY_TEXT_COLOR_HEX = '#2E584C';
const API_BASE = 'https://nginx-production-728f.up.railway.app/api';

function escapeHtml(str=''){
  return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'}[m]));
}

function formatCurrency(amount){
  return new Intl.NumberFormat('es-MX', { style:'currency', currency:'MXN', minimumFractionDigits:2 }).format(amount);
}

function getStatusBadge(status){
  const s = (status || '').toLowerCase();
  if (s === 'finalizado' || s === 'finalized') return '<span class="inline-flex items-center gap-1.5 mt-1 text-[10px] bg-gradient-to-r from-amber-100 to-orange-100 text-amber-800 px-3 py-1.5 rounded-full font-black uppercase shadow-md border border-amber-300"><i class="fas fa-flag-checkered"></i> Finalizado</span>';
  if (s === 'inactivo' || s === 'inactive') return '<span class="inline-flex items-center gap-1.5 mt-1 text-[10px] bg-gradient-to-r from-gray-100 to-slate-100 text-gray-700 px-3 py-1.5 rounded-full font-black uppercase shadow-md border border-gray-300"><i class="fas fa-pause-circle"></i> Inactivo</span>';
  return '<span class="inline-flex items-center gap-1.5 mt-1 text-[10px] bg-gradient-to-r from-emerald-100 to-teal-100 text-emerald-800 px-3 py-1.5 rounded-full font-black uppercase shadow-md border border-emerald-300 animate-pulse"><i class="fas fa-check-circle"></i> Vigente</span>';
}

async function apiFetch(url, options = {}) {
  const token = localStorage.getItem('access_token');
  if (!token) throw new Error('No hay token, inicia sesión');
  const res = await fetch(url, {
    ...options,
    headers: {
      'Accept': 'application/json',
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${token}`,
      ...options.headers,
    }
  });

  if (res.status === 204) return { success: true };

  const text = await res.text();
  const data = text ? JSON.parse(text) : {};

  if (!res.ok) {
    throw new Error(data.message || 'Error de API');
  }
  return data;
}

let conceptsCache = [];

async function loadConcepts(){
  const grid = document.getElementById('concepts-grid');
  if(!grid) return;
  grid.innerHTML = `
    <div class="col-span-full text-center py-20 bg-gradient-to-br from-white via-emerald-50/20 to-teal-50/10 rounded-3xl border-2 border-emerald-200/50 shadow-2xl">
      <div class="flex flex-col items-center gap-5">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-r from-emerald-400 to-teal-400 rounded-full blur-2xl opacity-30 animate-pulse"></div>
          <i class="fas fa-spinner fa-spin text-6xl text-emerald-700 relative z-10"></i>
        </div>
        <div class="space-y-2">
          <p class="text-[#2E594D] font-black text-xl">Cargando conceptos...</p>
          <p class="text-gray-600 text-sm font-medium">Por favor espera un momento</p>
        </div>
      </div>
    </div>
  `;
  try {
    const data = await apiFetch(`${API_BASE}/v1/concepts?perPage=50`, {
      headers: {
        'X-User-Role': 'financial-staff',
        'X-User-Permission': 'view.concepts'
      }
    });
    conceptsCache = data?.data?.concepts?.items || [];
    renderConcepts();
  } catch(err){
    console.error(err);
    grid.innerHTML = `
      <div class="col-span-full text-center py-20 bg-gradient-to-br from-red-50 via-rose-50 to-white rounded-3xl border-2 border-red-300 shadow-2xl">
        <div class="flex flex-col items-center gap-5">
          <div class="p-6 bg-gradient-to-br from-red-100 to-rose-100 rounded-full shadow-xl">
            <i class="fas fa-exclamation-triangle text-6xl text-red-600"></i>
          </div>
          <div class="space-y-2">
            <p class="text-red-800 font-black text-xl">Error al cargar conceptos</p>
            <p class="text-red-600 text-sm font-medium max-w-md">${escapeHtml(err.message || 'Error desconocido')}</p>
          </div>
          <button onclick="loadConcepts()" class="mt-2 px-6 py-3 bg-gradient-to-r from-red-600 to-rose-600 text-white font-bold rounded-xl shadow-lg hover:shadow-xl hover:scale-105 transition-all">
            <i class="fas fa-redo mr-2"></i> Reintentar
          </button>
        </div>
      </div>
    `;
  }
}

function renderConcepts(){
  const grid = document.getElementById('concepts-grid');
  if(!grid) return;
  const list = [...conceptsCache];
  if(!list.length){
    grid.innerHTML = `
      <div class="col-span-full text-center py-24 bg-gradient-to-br from-white via-emerald-50/30 to-teal-50/20 rounded-3xl shadow-2xl border-2 border-emerald-200/50">
        <div class="flex flex-col items-center gap-6">
          <div class="p-6 bg-gradient-to-br from-emerald-100 to-teal-100 rounded-full shadow-xl">
            <i class="fas fa-inbox text-7xl text-emerald-700"></i>
          </div>
          <div class="space-y-2">
            <p class="text-[#2E594D] font-black text-2xl">No hay conceptos registrados</p>
            <p class="text-gray-600 text-base font-medium">Comienza creando tu primer concepto de cobro</p>
          </div>
          <a href="/new" class="mt-4 px-8 py-4 bg-gradient-to-r from-[#2E594D] via-emerald-700 to-teal-700 text-white font-bold rounded-2xl shadow-xl hover:shadow-2xl hover:scale-105 hover:-translate-y-1 transition-all duration-300 flex items-center gap-3 group relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-emerald-600 to-teal-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <i class="fas fa-plus-circle text-lg relative z-10"></i>
            <span class="relative z-10">Crear Mi Primer Concepto</span>
          </a>
        </div>
      </div>
    `;
    return;
  }

  grid.innerHTML = list.map(c=>{
    const amount = Number(c.amount)||0;
    const isInactive = (c.status || '').toLowerCase() !== 'activo' && (c.status || '').toLowerCase() !== 'active';
    const scopeText = (() => {
      const applies = c.applies_to || c.appliesTo || '';
      if (applies === 'todos') return 'Todos';
      if (applies === 'students') return `${(c.userIds||c.user_ids||[]).length} alumnos`; 
      if (applies === 'career' || applies === 'careers') return `${(c.careerIds||c.careers||[]).length} carreras`;
      if (applies === 'semesters' || applies === 'semester') return `${(c.semesters||[]).length} semestres`;
      return 'No definido';
    })();
    
    // Intentar obtener estudiantes afectados de varios campos posibles
    const affectedCount = c.affectedStudentsCount || c.affected_students_count || 
                          (c.userIds||c.user_ids||[]).length || 
                          (c.metadata?.students_count) || 0;

    return `
      <div class="group bg-gradient-to-br ${isInactive ? 'from-amber-50 via-orange-50 to-amber-50 border-amber-300/50' : 'from-white via-emerald-50/20 to-teal-50/10 border-gray-200'} rounded-3xl shadow-xl border-2 p-7 flex flex-col justify-between transition-all hover:shadow-2xl hover:scale-[1.03] hover:-translate-y-1 duration-500 relative overflow-hidden">
        <!-- Decoración de fondo -->
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br ${isInactive ? 'from-amber-400/10' : 'from-emerald-400/10'} to-transparent rounded-full blur-2xl -z-0"></div>
        
        <div class="flex justify-between items-start mb-6 pb-5 border-b-2 ${isInactive ? 'border-amber-200' : 'border-gray-100'} relative z-10">
          <div class="pr-3 flex-1">
            <div class="flex items-center gap-3 mb-3">
              <div class="p-2 bg-gradient-to-br ${isInactive ? 'from-amber-100 to-orange-100' : 'from-emerald-100 to-teal-100'} rounded-xl shadow-md">
                <i class="fas fa-receipt ${isInactive ? 'text-amber-700' : 'text-emerald-700'} text-base"></i>
              </div>
              <h3 class="font-black text-xl text-gray-900 leading-tight line-clamp-2 group-hover:text-[#2E594D] transition-colors">${escapeHtml(c.concept_name || c.conceptName || c.title || '')}</h3>
            </div>
            ${getStatusBadge(c.status)}
          </div>
          <div class="flex flex-col items-end bg-gradient-to-br from-[#2E594D] via-emerald-700 to-teal-700 px-5 py-4 rounded-2xl shadow-2xl flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
            <span class="text-[10px] text-white/80 font-bold uppercase tracking-widest mb-1">💰 Monto</span>
            <span class="text-2xl font-black text-white">${formatCurrency(amount)}</span>
          </div>
        </div>

        <!-- Sección de Alcance y Vigencia -->
        <div class="space-y-3 py-4 rounded-2xl ${isInactive ? 'bg-amber-100/30' : 'bg-emerald-100/20'} border-2 ${isInactive ? 'border-amber-300/50' : 'border-emerald-300/40'} px-4 mb-6 relative z-10">
          <!-- Alcance -->
          <div class="flex items-center justify-between gap-3 p-3 bg-white rounded-lg shadow-sm hover:shadow-md transition-all">
            <div class="flex items-center gap-2">
              <div class="p-2 ${isInactive ? 'bg-amber-100' : 'bg-emerald-100'} rounded-lg">
                <i class="fas fa-bullseye ${isInactive ? 'text-amber-600' : 'text-emerald-600'} text-sm"></i>
              </div>
              <span class="text-gray-700 font-bold text-xs uppercase tracking-widest">Alcance</span>
            </div>
            <span class="font-semibold text-gray-800 text-sm bg-gradient-to-r ${isInactive ? 'from-amber-50 to-orange-50' : 'from-emerald-50 to-teal-50'} px-3 py-1 rounded-lg border ${isInactive ? 'border-amber-200' : 'border-emerald-200'}">${scopeText}</span>
          </div>
          
          <!-- Vigencia -->
          <div class="flex items-center justify-between gap-3 p-3 bg-white rounded-lg shadow-sm hover:shadow-md transition-all">
            <div class="flex items-center gap-2">
              <div class="p-2 ${isInactive ? 'bg-amber-100' : 'bg-blue-100'} rounded-lg">
                <i class="fas fa-calendar-alt ${isInactive ? 'text-amber-600' : 'text-blue-600'} text-sm"></i>
              </div>
              <span class="text-gray-700 font-bold text-xs uppercase tracking-widest">Vigencia</span>
            </div>
            <span class="font-semibold text-gray-800 text-sm bg-gradient-to-r from-blue-50 to-indigo-50 px-3 py-1 rounded-lg border border-blue-200">${escapeHtml(c.start_date || '-')} → ${escapeHtml(c.end_date || '-')}</span>
          </div>
        </div>

        <div class="space-y-4">
          <div class="hidden text-sm text-gray-700 bg-gradient-to-br from-blue-50 via-indigo-50/50 to-white p-5 rounded-2xl border-2 border-blue-200 mb-3 shadow-lg backdrop-blur-sm" id="details-${c.id}">
              <div class="flex items-start gap-3">
                <div class="p-2 bg-gradient-to-br from-blue-100 to-indigo-100 rounded-lg shadow-md flex-shrink-0">
                  <i class="fas fa-info-circle text-blue-600 text-base"></i>
                </div>
                <div class="flex-1">
                  <p class="font-black text-blue-900 mb-2 flex items-center gap-2">
                    <span>Descripción del Concepto</span>
                  </p>
                  <p class="text-gray-700 leading-relaxed">${escapeHtml(c.description || 'Sin descripción disponible.')}</p>
                </div>
              </div>
          </div>
          
          <div class="grid grid-cols-3 gap-3 relative z-10">
            <button onclick="window.editConcept('${c.id}')" class="group/btn py-4 text-xs font-bold bg-gradient-to-br from-[#2E594D] via-emerald-700 to-teal-700 text-white rounded-xl hover:shadow-2xl hover:scale-105 hover:-translate-y-1 transition-all duration-300 relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-r from-emerald-600 to-teal-600 opacity-0 group-hover/btn:opacity-100 transition-opacity"></div>
              <i class="fas fa-edit mb-1 block text-lg relative z-10 group-hover/btn:rotate-12 transition-transform"></i>
              <span class="relative z-10">Editar</span>
            </button>

            ${!isInactive ? `
              <button onclick="window.finalizeConcept('${c.id}')" class="group/btn py-4 text-xs font-bold bg-gradient-to-br from-amber-100 to-orange-100 text-amber-800 rounded-xl hover:shadow-2xl hover:scale-105 hover:-translate-y-1 border-2 border-amber-300 transition-all duration-300 relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-r from-amber-200 to-orange-200 opacity-0 group-hover/btn:opacity-100 transition-opacity"></div>
                <i class="fas fa-check-double mb-1 block text-lg relative z-10 group-hover/btn:scale-110 transition-transform"></i>
                <span class="relative z-10">Finalizar</span>
              </button>
            ` : `
              <button onclick="window.activateConcept('${c.id}')" class="group/btn py-4 text-xs font-bold bg-gradient-to-br from-emerald-100 to-teal-100 text-emerald-800 rounded-xl hover:shadow-2xl hover:scale-105 hover:-translate-y-1 border-2 border-emerald-300 transition-all duration-300 relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-r from-emerald-200 to-teal-200 opacity-0 group-hover/btn:opacity-100 transition-opacity"></div>
                <i class="fas fa-play mb-1 block text-lg relative z-10 group-hover/btn:translate-x-1 transition-transform"></i>
                <span class="relative z-10">Activar</span>
              </button>
            `}

            <button onclick="window.deleteConcept('${c.id}')" class="group/btn py-4 text-xs font-bold bg-gradient-to-br from-red-100 to-rose-100 text-red-800 rounded-xl hover:shadow-2xl hover:scale-105 hover:-translate-y-1 border-2 border-red-300 transition-all duration-300 relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-r from-red-200 to-rose-200 opacity-0 group-hover/btn:opacity-100 transition-opacity"></div>
              <i class="fas fa-trash-alt mb-1 block text-lg relative z-10 group-hover/btn:rotate-12 transition-transform"></i>
              <span class="relative z-10">Borrar</span>
            </button>
          </div>
          
          <button onclick="document.getElementById('details-${c.id}').classList.toggle('hidden')" class="w-full text-xs text-[#2E594D] hover:text-white font-bold tracking-wider transition-all bg-gradient-to-r from-emerald-50 to-teal-50 hover:from-[#2E594D] hover:to-emerald-700 py-3 rounded-xl border-2 border-emerald-200 hover:border-emerald-600 shadow-md hover:shadow-xl relative z-10 group/info">
            <i class="fas fa-info-circle mr-2 group-hover/info:rotate-180 transition-transform duration-500"></i> 
            <span>Ver descripción completa</span>
            <i class="fas fa-chevron-down ml-2 group-hover/info:translate-y-1 transition-transform"></i>
          </button>
        </div>
      </div>
    `;
  }).join('');
}

async function mutateConcept(id, action){
  const endpoints = {
    finalize: `${API_BASE}/v1/concepts/${id}/finalize`,
    activate: `${API_BASE}/v1/concepts/${id}/activate`,
    disable: `${API_BASE}/v1/concepts/${id}/disable`,
    delete: `${API_BASE}/v1/concepts/${id}/eliminateLogical`
  };
  const perms = {
    finalize: 'finalize.concepts',
    activate: 'activate.concepts',
    disable: 'disable.concepts',
    delete: 'eliminate.logical.concepts'
  };
  const methods = {
    finalize: 'POST',
    activate: 'POST',
    disable: 'POST',
    delete: 'POST'
  };
  
  try {
    await apiFetch(endpoints[action], {
      method: methods[action],
      headers: {
        'X-User-Role': 'financial-staff',
        'X-User-Permission': perms[action]
      }
    });
    
    // Mostrar mensaje de éxito
    const successMessages = {
      finalize: 'Concepto finalizado exitosamente',
      activate: 'Concepto activado exitosamente',
      disable: 'Concepto deshabilitado exitosamente',
      delete: 'Concepto marcado como eliminado'
    };
    alert(`✓ ${successMessages[action]}`);
    
    await loadConcepts();
    return true;
  } catch (err) {
    console.error(`Error en ${action}:`, err);
    
    // Manejo especial para conflictos 409 o mensajes de estado ya existente
    if (err.message.includes('ya está') || 
        err.message.includes('ya fue') || 
        err.message.includes('elimina')) {
      alert(`⚠️ ${err.message}\n\nActualizando lista...`);
      await loadConcepts(); // Recargar para mostrar estado actualizado
      return false;
    } else {
      alert(`❌ Error: ${err.message}`);
      return false;
    }
  }
}

/* --- EXPOSICIÓN GLOBAL --- */
window.editConcept = (id) => {
  const c = conceptsCache.find(x=>String(x.id)===String(id));
  localStorage.setItem('editingConcept', JSON.stringify({
    id: c.id,
    title: c.concept_name || c.conceptName,
    amount: c.amount,
    description: c.description,
    status: c.status,
    start_date: c.start_date,
    end_date: c.end_date,
    scopeRules: {
      allStudents: (c.applies_to || c.appliesTo) === 'todos',
      careers: c.careerIds || c.careers || [],
      semesters: c.semesters || [],
      specificStudents: c.userIds || c.user_ids || []
    }
  }));
  window.location.href = '/new?edit='+encodeURIComponent(id);
};
window.finalizeConcept = (id) => mutateConcept(id, 'finalize');
window.activateConcept = (id) => mutateConcept(id, 'activate');
window.deleteConcept = (id) => {
  if(!confirm('⚠️ ¿Marcar concepto como eliminado (borrado lógico)?')) return;
  mutateConcept(id, 'delete');
};

loadConcepts();
</script>

<style>
.hidden { display:none; }
.line-clamp-2 { overflow:hidden; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.col-span-full { grid-column: 1 / -1; }
</style>
</Layout>