---
// src/pages/concepts.astro
import Layout from '../layouts/Layout.astro'; 
const pageTitle = "Conceptos de Cobro"; 

const PRIMARY_ACCENT_COLOR = 'bg-[#2E584C]'; 
const PRIMARY_HOVER = 'hover:bg-[#274D43]'; 
const PRIMARY_TEXT_COLOR = 'text-[#2E584C]'; 
const API_BASE_URL = 'https://nginx-production-728f.up.railway.app/api';
---

<Layout title={pageTitle}>  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10 bg-gradient-to-br from-gray-50 via-white to-[#2E594D]/5 min-h-screen">

  
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-10 pb-6 border-b-2 border-[#2E594D]/20 bg-white rounded-2xl shadow-lg px-6 py-5">
      <div class="flex items-center gap-4">
        <div class="p-4 bg-gradient-to-br from-[#2E594D] to-[#1e3d35] rounded-2xl shadow-xl flex-shrink-0">
          <i class="fas fa-file-invoice-dollar text-3xl text-white"></i>
        </div>

        <div>
          <h1 class="text-3xl font-extrabold text-[#2E594D] tracking-tight flex items-center gap-3">
            Gestión de Conceptos de Cobro
            <span class="text-xs bg-[#2E594D]/10 text-[#2E594D] px-3 py-1 rounded-full font-semibold">Sistema de Pagos</span>
          </h1>
          <p class="text-sm text-gray-600 mt-2 flex items-center gap-2">
            <i class="fas fa-info-circle text-[#2E594D]"></i>
            Definición y asignación de adeudos a grupos de estudiantes
          </p>
        </div>
      </div>

      <a href="/new"
         class="mt-4 sm:mt-0 px-6 py-3 bg-gradient-to-r from-[#2E594D] to-[#1e3d35] text-white font-bold rounded-xl shadow-xl hover:shadow-2xl hover:scale-105 transition-all duration-300 text-sm sm:text-base flex items-center gap-2">
        <i class="fas fa-plus-circle"></i> 
        <span>Crear Nuevo Concepto</span>
      </a>
    </header>

    <div id="concepts-grid"
         class="grid gap-8"
         style="grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));">
    </div>

  </div>

<script type="module">
const PRIMARY_TEXT_COLOR_HEX = '#2E584C';
const API_BASE = 'https://nginx-production-728f.up.railway.app/api';

function escapeHtml(str=''){
  return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'}[m]));
}

function formatCurrency(amount){
  return new Intl.NumberFormat('es-MX', { style:'currency', currency:'MXN', minimumFractionDigits:2 }).format(amount);
}

function getStatusBadge(status){
  const s = (status || '').toLowerCase();
  if (s === 'finalizado' || s === 'finalized') return '<span class="inline-block mt-1 text-[10px] bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full font-bold uppercase">Finalizado</span>';
  if (s === 'inactivo' || s === 'inactive') return '<span class="inline-block mt-1 text-[10px] bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full font-bold uppercase">Inactivo</span>';
  return '<span class="inline-block mt-1 text-[10px] bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full font-bold uppercase">Vigente</span>';
}

async function apiFetch(url, options = {}) {
  const token = localStorage.getItem('access_token');
  if (!token) throw new Error('No hay token, inicia sesión');
  const res = await fetch(url, {
    ...options,
    headers: {
      'Accept': 'application/json',
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${token}`,
      ...options.headers,
    }
  });

  if (res.status === 204) return { success: true };

  const text = await res.text();
  const data = text ? JSON.parse(text) : {};

  if (!res.ok) {
    throw new Error(data.message || 'Error de API');
  }
  return data;
}

let conceptsCache = [];

async function loadConcepts(){
  const grid = document.getElementById('concepts-grid');
  if(!grid) return;
  grid.innerHTML = '<div class="col-span-full text-center py-16 bg-gradient-to-br from-white to-[#2E594D]/5 rounded-2xl border-2 border-[#2E594D]/20 shadow-xl"><div class="flex flex-col items-center gap-4"><i class="fas fa-spinner fa-spin text-5xl text-[#2E594D]"></i><p class="text-[#2E594D] font-bold text-lg">Cargando conceptos...</p></div></div>';
  try {
    const data = await apiFetch(`${API_BASE}/v1/concepts?perPage=50`, {
      headers: {
        'X-User-Role': 'financial-staff',
        'X-User-Permission': 'view.concepts'
      }
    });
    conceptsCache = data?.data?.concepts?.items || [];
    renderConcepts();
  } catch(err){
    console.error(err);
    grid.innerHTML = `<div class="col-span-full text-center py-16 bg-gradient-to-br from-red-50 to-white rounded-2xl border-2 border-red-300 shadow-xl"><div class="flex flex-col items-center gap-4"><i class="fas fa-exclamation-triangle text-5xl text-red-600"></i><p class="text-red-700 font-bold text-lg">Error al cargar conceptos</p><p class="text-red-600 text-sm">${escapeHtml(err.message || 'Error desconocido')}</p></div></div>`;
  }
}

function renderConcepts(){
  const grid = document.getElementById('concepts-grid');
  if(!grid) return;
  const list = [...conceptsCache];
  if(!list.length){
    grid.innerHTML = `<div class="col-span-full text-center py-20 bg-gradient-to-br from-white to-[#2E594D]/5 rounded-2xl shadow-2xl border-2 border-[#2E594D]/20"><div class="flex flex-col items-center gap-4"><i class="fas fa-inbox text-6xl text-[#2E594D]/50"></i><p class="text-[#2E594D] font-bold text-xl">No hay conceptos registrados</p><p class="text-gray-600 text-sm">Comienza creando tu primer concepto de cobro</p><a href="/new" class="mt-4 px-6 py-3 bg-gradient-to-r from-[#2E594D] to-[#1e3d35] text-white font-bold rounded-xl shadow-lg hover:shadow-xl hover:scale-105 transition-all"><i class="fas fa-plus-circle mr-2"></i>Crear Concepto</a></div></div>`;
    return;
  }

  grid.innerHTML = list.map((c, idx)=>{
    // Mostrar estructura del primer concepto para debugging
    if (idx === 0) {
      console.log('📋 Estructura del concepto:', c);
      console.log('🔍 Buscando campos de monto:', {
        amount: c.amount,
        monto: c.monto,
        totalAmount: c.totalAmount,
        value: c.value,
        precio: c.precio
      });
    }

    // Mapeo flexible de campos de monto con manejo de strings con coma
    let amount = 0;
    const parseAmount = (val) => {
      if (val === undefined || val === null || val === '') return 0;
      // Remover comas y convertir a número
      const numStr = String(val).replace(/,/g, '');
      return parseFloat(numStr) || 0;
    };

    if (c.amount !== undefined && c.amount !== null && c.amount !== '') {
      amount = parseAmount(c.amount);
    } else if (c.monto !== undefined && c.monto !== null && c.monto !== '') {
      amount = parseAmount(c.monto);
    } else if (c.totalAmount !== undefined && c.totalAmount !== null) {
      amount = parseAmount(c.totalAmount);
    } else if (c.value !== undefined && c.value !== null) {
      amount = parseAmount(c.value);
    } else if (c.precio !== undefined && c.precio !== null) {
      amount = parseAmount(c.precio);
    }

    console.log(`💰 Concepto "${c.concept_name}" - Monto parseado: ${amount}`);

    const isInactive = (c.status || '').toLowerCase() !== 'activo' && (c.status || '').toLowerCase() !== 'active';
    const scopeText = (() => {
      const applies = c.applies_to || c.appliesTo || '';
      if (applies === 'todos') return 'Todos';
      if (applies === 'students') return `${(c.userIds||c.user_ids||[]).length} alumnos`; 
      if (applies === 'career' || applies === 'careers') return `${(c.careerIds||c.careers||[]).length} carreras`;
      if (applies === 'semesters' || applies === 'semester') return `${(c.semesters||[]).length} semestres`;
      return 'No definido';
    })();
    
    // Obtener fechas con flexibilidad en nombres
    const startDate = c.start_date || c.startDate || c.inicio || '-';
    const endDate = c.end_date || c.endDate || c.fin || '-';
    
    // Intentar obtener estudiantes afectados de varios campos posibles
    const affectedCount = c.affectedStudentsCount || c.affected_students_count || 
                          (c.userIds||c.user_ids||[]).length || 
                          (c.metadata?.students_count) || 0;

    return `
      <div class="bg-gradient-to-br ${isInactive ? 'from-amber-50 via-white to-amber-50 border-amber-300' : 'from-white via-[#2E594D]/5 to-white border-[#2E594D]/20'} rounded-2xl shadow-xl border-2 p-6 flex flex-col justify-between transition-all hover:shadow-2xl hover:scale-[1.02] duration-300" data-concept-id="${c.id}">
        <div class="flex justify-between items-start mb-6 pb-4 border-b-2 ${isInactive ? 'border-amber-200' : 'border-[#2E594D]/10'}">
          <div class="pr-3 flex-1">
            <div class="flex items-center gap-2 mb-2">
              <i class="fas fa-receipt text-[${PRIMARY_TEXT_COLOR_HEX}] text-lg"></i>
              <h3 class="font-black text-xl text-gray-900 leading-tight line-clamp-2">${escapeHtml(c.concept_name || c.conceptName || c.title || '')}</h3>
            </div>
            ${getStatusBadge(c.status)}
          </div>
          <div class="flex flex-col items-end bg-gradient-to-br from-[#2E594D] to-[#1e3d35] px-4 py-3 rounded-xl shadow-lg flex-shrink-0">
            <span class="text-xs text-white/80 font-semibold uppercase tracking-wide">Monto</span>
            <span class="text-2xl font-black text-white">${formatCurrency(amount)}</span>
          </div>
        </div>

        <div class="text-sm space-y-4 py-5 rounded-xl ${isInactive ? 'bg-amber-50/50' : 'bg-[#2E594D]/5'} border-2 ${isInactive ? 'border-amber-200' : 'border-[#2E594D]/20'} px-5 mb-6 shadow-inner">
          <div class="flex justify-between items-center">
            <div class="flex items-center gap-2">
              <i class="fas fa-filter text-[${PRIMARY_TEXT_COLOR_HEX}]"></i>
              <span class="text-[${PRIMARY_TEXT_COLOR_HEX}] font-bold text-xs uppercase tracking-wider">Alcance</span>
            </div>
            <span class="font-bold text-gray-800 bg-white px-3 py-1 rounded-lg shadow-sm">${scopeText}</span>
          </div>
          <div class="flex justify-between items-center">
            <div class="flex items-center gap-2">
              <i class="fas fa-calendar-alt text-[${PRIMARY_TEXT_COLOR_HEX}]"></i>
              <span class="text-[${PRIMARY_TEXT_COLOR_HEX}] font-bold text-xs uppercase tracking-wider">Vigencia</span>
            </div>
            <span class="font-semibold text-gray-800 bg-white px-3 py-1 rounded-lg shadow-sm text-xs">${escapeHtml(startDate || '-')} - ${escapeHtml(endDate || '-')}</span>
          </div>
        </div>

        <div class="space-y-4">
          <div class="hidden text-sm text-gray-700 bg-gradient-to-br from-blue-50 to-white p-4 rounded-xl border-2 border-blue-200 mb-3 shadow-inner" id="details-${c.id}">
              <div class="flex items-start gap-2">
                <i class="fas fa-info-circle text-blue-500 mt-1"></i>
                <div>
                  <p class="font-semibold text-blue-900 mb-1">Descripción del Concepto:</p>
                  <p class="text-gray-700">${escapeHtml(c.description || 'Sin descripción.')}</p>
                </div>
              </div>
          </div>
          
          <div class="grid grid-cols-3 gap-3">
            <button onclick="window.editConcept('${c.id}')" class="py-3 text-xs font-bold bg-gradient-to-br from-[#2E594D] to-[#1e3d35] text-white rounded-xl hover:shadow-xl hover:scale-105 transition-all duration-300">
              <i class="fas fa-edit mb-1 block text-base"></i>
              <span>Editar</span>
            </button>

            ${!isInactive ? `
              <button onclick="window.finalizeConcept('${c.id}')" class="py-3 text-xs font-bold bg-gradient-to-br from-amber-50 to-amber-100 text-amber-700 rounded-xl hover:shadow-xl hover:scale-105 border-2 border-amber-300 transition-all duration-300">
                <i class="fas fa-check-double mb-1 block text-base"></i>
                <span>Finalizar</span>
              </button>
            ` : `
              <button onclick="window.activateConcept('${c.id}')" class="py-3 text-xs font-bold bg-gradient-to-br from-emerald-50 to-emerald-100 text-emerald-700 rounded-xl hover:shadow-xl hover:scale-105 border-2 border-emerald-300 transition-all duration-300">
                <i class="fas fa-play mb-1 block text-base"></i>
                <span>Activar</span>
              </button>
            `}

            <button onclick="window.deleteConcept('${c.id}')" class="py-3 text-xs font-bold bg-gradient-to-br from-red-50 to-red-100 text-red-700 rounded-xl hover:shadow-xl hover:scale-105 border-2 border-red-300 transition-all duration-300">
              <i class="fas fa-trash-alt mb-1 block text-base"></i>
              <span>Borrar</span>
            </button>
          </div>
          
          <button onclick="document.getElementById('details-${c.id}').classList.toggle('hidden')" class="w-full text-xs text-[#2E594D] hover:text-[#1e3d35] font-bold tracking-wider transition bg-[#2E594D]/5 hover:bg-[#2E594D]/10 py-2 rounded-lg border border-[#2E594D]/20">
            <i class="fas fa-info-circle mr-1"></i> Ver descripción <i class="fas fa-chevron-down ml-1"></i>
          </button>
        </div>
      </div>
    `;
  }).join('');
}

async function mutateConcept(id, action){
  const endpoints = {
    finalize: `${API_BASE}/v1/concepts/${id}/finalize`,
    activate: `${API_BASE}/v1/concepts/${id}/activate`,
    disable: `${API_BASE}/v1/concepts/${id}/disable`,
    delete: `${API_BASE}/v1/concepts/${id}/eliminateLogical`
  };
  const perms = {
    finalize: 'finalize.concepts',
    activate: 'activate.concepts',
    disable: 'disable.concepts',
    delete: 'eliminate.logical.concepts'
  };
  const methods = {
    finalize: 'POST',
    activate: 'POST',
    disable: 'POST',
    delete: 'POST'
  };
  
  try {
    await apiFetch(endpoints[action], {
      method: methods[action],
      headers: {
        'X-User-Role': 'financial-staff',
        'X-User-Permission': perms[action]
      }
    });
    
    console.log(`✅ ${action} exitoso para concepto ${id}`);
    
    // Si es delete, remover inmediatamente del DOM y cache
    if (action === 'delete') {
      console.log(`🗑️ Ejecutando eliminación visual para ID ${id}`);
      
      // Remover del cache primero
      const beforeLen = conceptsCache.length;
      conceptsCache = conceptsCache.filter(c => String(c.id) !== String(id));
      console.log(`Cache: ${beforeLen} → ${conceptsCache.length} items`);
      
      // Buscar y animar removal del DOM
      const cardEl = document.querySelector(`[data-concept-id="${id}"]`);
      console.log(`Elemento DOM encontrado: ${!!cardEl}`);
      
      if (cardEl) {
        // Aplicar animación de salida
        cardEl.style.transition = 'all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55)';
        cardEl.style.opacity = '0';
        cardEl.style.transform = 'translateX(100px) scale(0)';
        cardEl.style.pointerEvents = 'none';
        
        // Remover del DOM después de animación
        setTimeout(() => {
          if (cardEl && cardEl.parentNode) {
            try {
              cardEl.parentNode.removeChild(cardEl);
              console.log(`✅ Elemento removido del DOM`);
            } catch (e) {
              console.error(`Error removiendo elemento:`, e);
            }
          }
        }, 500);
      }
      
      alert(`✓ Concepto eliminado exitosamente`);
      return true;
    } else {
      // Para otros actions, recargar lista completa
      await loadConcepts();
      alert(`✓ Operación ejecutada exitosamente`);
      return true;
    }
  } catch (err) {
    const errorMsg = (err.message || String(err)).toLowerCase();
    console.error(`❌ Error en ${action}:`, err);
    console.log(`Mensaje error lowercase: "${errorMsg}"`);
    console.log(`Buscando palabras clave...`);
    console.log(`- "ya está eliminado": ${errorMsg.includes('ya está eliminado')}`);
    console.log(`- "conflict": ${errorMsg.includes('conflict')}`);
    
    // Detectar si ya está eliminado
    const isAlreadyDeleted = errorMsg.includes('ya está eliminado') || 
                           errorMsg.includes('ya fue eliminado') ||
                           errorMsg.includes('conflict') ||
                           errorMsg.includes('409');
    
    console.log(`isAlreadyDeleted: ${isAlreadyDeleted}, action: ${action}`);
    
    if (isAlreadyDeleted && action === 'delete') {
      console.warn(`⚠️ Concepto ${id} ya estaba eliminado en servidor. Sincronizando UI...`);
      
      // Buscar y remover el elemento
      const cardEl = document.querySelector(`[data-concept-id="${id}"]`);
      console.log(`Elemento encontrado: ${!!cardEl}`);
      
      if (cardEl) {
        // Remover con animación
        cardEl.style.transition = 'all 0.4s ease-out';
        cardEl.style.opacity = '0';
        cardEl.style.pointerEvents = 'none';
        cardEl.style.height = '0';
        cardEl.style.marginTop = '0';
        cardEl.style.marginBottom = '0';
        cardEl.style.overflow = 'hidden';
        
        setTimeout(() => {
          console.log(`Removiendo del DOM...`);
          if (cardEl && cardEl.parentNode) {
            cardEl.parentNode.removeChild(cardEl);
            console.log(`✅ Elemento removido del DOM`);
          }
        }, 400);
      } else {
        console.warn(`⚠️ No se encontró elemento [data-concept-id="${id}"]`);
      }
      
      // Remover del cache
      const beforeLen = conceptsCache.length;
      conceptsCache = conceptsCache.filter(c => String(c.id) !== String(id));
      console.log(`Cache: ${beforeLen} → ${conceptsCache.length} items`);
      
      alert('⚠️ Ya estaba eliminado. Vista sincronizada.');
      return true;
    } else {
      alert(`❌ Error: ${err.message}`);
      return false;
    }
  }
}

/* --- EXPOSICIÓN GLOBAL --- */
window.editConcept = (id) => {
  const c = conceptsCache.find(x=>String(x.id)===String(id));
  localStorage.setItem('editingConcept', JSON.stringify({
    id: c.id,
    title: c.concept_name || c.conceptName,
    amount: c.amount,
    description: c.description,
    status: c.status,
    start_date: c.start_date,
    end_date: c.end_date,
    scopeRules: {
      allStudents: (c.applies_to || c.appliesTo) === 'todos',
      careers: c.careerIds || c.careers || [],
      semesters: c.semesters || [],
      specificStudents: c.userIds || c.user_ids || []
    }
  }));
  window.location.href = '/new?edit='+encodeURIComponent(id);
};
window.finalizeConcept = (id) => mutateConcept(id, 'finalize');
window.activateConcept = (id) => mutateConcept(id, 'activate');
window.deleteConcept = (id) => {
  if(!confirm('⚠️ ¿Marcar concepto como eliminado (borrado lógico)?')) return;
  mutateConcept(id, 'delete');
};

loadConcepts();
</script>

<style>
.hidden { display:none; }
.line-clamp-2 { overflow:hidden; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.col-span-full { grid-column: 1 / -1; }
</style>
</Layout>